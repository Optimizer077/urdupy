"""مکمل پچاس دور کی تربیت کے محفوظ نتائج کی آزاد حسابی جانچ۔

یہ معاون ماڈل نہیں چلاتا؛ اصل نشان، محفوظ پیشگوئیوں، تقسیم، ہیش اور خاکوں
کی جانچ کرتا ہے۔ آزمائشی مجموعے پر نئی تربیت یا ترتیب کا انتخاب نہیں ہوتا۔
"""

درآمد argparse
درآمد csv
درآمد hashlib
درآمد json
درآمد math
سے collections درآمد Counter
سے datetime درآمد datetime, timezone
سے pathlib درآمد Path
درآمد xml.etree.ElementTree بطور XML

سے PIL درآمد Image


_اصل_جانچ = {
    "train_X.bin": "918c2871b30a85fa023e0c44e0bee87f",
    "train_y.bin": "5a34089d4802c674881badbb80307741",
    "test_X.bin": "7f263ba9f9e0b06b93213547f721ac82",
    "test_y.bin": "36f9794fa4beb8a2c72628de14fa638e",
}
_اردو_جماعتیں = ["ہوائی جہاز", "پرندہ", "گاڑی", "بلی", "ہرن", "کتا", "گھوڑا", "بندر", "بحری جہاز", "ٹرک"]
_انگریزی_جماعتیں = ["airplane", "bird", "car", "cat", "deer", "dog", "horse", "monkey", "ship", "truck"]
_خاکوں_کے_نام = ["تربیتی_خاکے", "الجھاؤ_جدول", "جماعتی_درستگی", "پیشگوئیاں"]
_اردو_ہندسے = str.maketrans("0123456789%", "۰۱۲۳۴۵۶۷۸۹٪")


فنکشن ثبوت_چاہیے(شرط, پیغام):
    اگر نہیں شرط:
        اٹھاؤ ValueError(پیغام)


فنکشن محدود_عدد(قدر, کم=0.0, زیادہ=کچھ_نہیں):
    واپس type(قدر) میں (int, float) اور math.isfinite(قدر) اور قدر >= کم اور (زیادہ ہے کچھ_نہیں یا قدر <= زیادہ)


فنکشن فائل_ہیش(راستہ, algorithm="sha256"):
    جانچ = hashlib.new(algorithm)
    ساتھ Path(راستہ).open("rb") بطور فائل:
        جب_تک ٹکڑا := فائل.read(8 * 1024 * 1024):
            جانچ.update(ٹکڑا)
    واپس جانچ.hexdigest()


فنکشن پڑھو(راستہ):
    واپس json.loads(Path(راستہ).read_text(encoding="utf-8"))


فنکشن الجھاؤ_گنو(حقیقی, پیشگوئیاں, classes=10):
    """صف حقیقی جماعت ہے؛ ستون پیشگوئی کردہ جماعت ہے۔"""
    ثبوت_چاہیے(type(classes) ہے int اور classes > 0, "جماعتوں کی تعداد مثبت صحیح عدد ہو۔")
    ثبوت_چاہیے(لمبائی(حقیقی) == لمبائی(پیشگوئیاں) اور لمبائی(حقیقی) > 0, "اصل نشان اور پیشگوئیاں یکساں اور غیر خالی ہوں۔")
    جدول = [[0 ہر _ میں حد(classes)] ہر _ میں حد(classes)]
    ہر اصل, اندازہ میں zip(حقیقی, پیشگوئیاں):
        ثبوت_چاہیے(type(اصل) ہے int اور type(اندازہ) ہے int اور 0 <= اصل < classes اور 0 <= اندازہ < classes, "جماعت کا اشاریہ صحیح عدد اور مقررہ حد میں ہو۔")
        جدول[اصل][اندازہ] += 1
    واپس جدول


فنکشن بہترین_دور_چنو(تاریخ):
    ثبوت_چاہیے(bool(تاریخ), "تربیتی تاریخ خالی ہے۔")
    ہر سطر میں تاریخ:
        ثبوت_چاہیے(محدود_عدد(سطر["val_accuracy"], زیادہ=1), "توثیقی درستگی محدود صفر تا ایک عدد ہو۔")
    بہترین_قدر = max(سطر["val_accuracy"] ہر سطر میں تاریخ)
    واپس next(سطر["epoch"] ہر سطر میں تاریخ اگر سطر["val_accuracy"] == بہترین_قدر), بہترین_قدر


فنکشن خاکے_جانچو(منزل, درج_راستے):
    متوقع = {f"خاکے/{نام}.{توسیع}" ہر نام میں _خاکوں_کے_نام ہر توسیع میں ("png", "svg")}
    ثبوت_چاہیے(type(درج_راستے) ہے list اور لمبائی(درج_راستے) == 8 اور {Path(راستہ).as_posix() ہر راستہ میں درج_راستے} == متوقع, "رپورٹ میں چار خاکوں کے آٹھ متوقع تصویری راستے درج ہوں۔")
    ثبوت = []
    ہر نام میں _خاکوں_کے_نام:
        تصویری_راستہ = منزل / "خاکے" / f"{نام}.png"
        ویکٹر_راستہ = منزل / "خاکے" / f"{نام}.svg"
        ثبوت_چاہیے(تصویری_راستہ.is_file() اور ویکٹر_راستہ.is_file(), f"خاکہ موجود نہیں: {نام}")
        ساتھ Image.open(تصویری_راستہ) بطور تصویر:
            ثبوت_چاہیے(تصویر.format == "PNG", f"تصویری فائل پی این جی نہیں: {نام}")
            تصویر.verify()
        ساتھ Image.open(تصویری_راستہ) بطور تصویر:
            تصویر.load()
            چوڑائی, بلندی = تصویر.size
            ثبوت_چاہیے(چوڑائی >= 400 اور بلندی >= 300, f"خاکہ کی جسامت ناکافی ہے: {نام}")
        جڑ = XML.parse(ویکٹر_راستہ).getroot()
        ثبوت_چاہیے(جڑ.tag == "{http://www.w3.org/2000/svg}svg", f"ویکٹر خاکہ ایس وی جی نہیں: {نام}")
        خانہ = [float(قدر) ہر قدر میں جڑ.attrib["viewBox"].split()]
        ثبوت_چاہیے(لمبائی(خانہ) == 4 اور all(math.isfinite(قدر) ہر قدر میں خانہ) اور خانہ[2] > 0 اور خانہ[3] > 0, f"ویکٹر خاکے کی جسامت غلط ہے: {نام}")
        ثبوت.append({"name": نام, "png": str(تصویری_راستہ.relative_to(منزل)), "png_width": چوڑائی, "png_height": بلندی, "png_sha256": فائل_ہیش(تصویری_راستہ), "svg": str(ویکٹر_راستہ.relative_to(منزل)), "svg_sha256": فائل_ہیش(ویکٹر_راستہ), "svg_xml_valid": سچ})
    واپس ثبوت


فنکشن جدول_محفوظ_کرو(منزل, جدول):
    ساتھ (منزل / "الجھاؤ_جدول.csv").open("w", newline="", encoding="utf-8-sig") بطور فائل:
        مصنف = csv.writer(فائل)
        مصنف.writerow(["حقیقی_جماعت_بمقابلہ_پیشگوئی"] + _اردو_جماعتیں)
        ہر نام, صف میں zip(_اردو_جماعتیں, جدول):
            مصنف.writerow([نام] + صف)
    ساتھ (منزل / "جماعتی_نتائج.csv").open("w", newline="", encoding="utf-8-sig") بطور فائل:
        مصنف = csv.writer(فائل)
        مصنف.writerow(["حقیقی_جماعت", "کل_تصاویر", "درست_پیشگوئیاں", "غلط_پیشگوئیاں", "بازیافت_تناسب", "بازیافت_فیصد"])
        ہر مقام, نام میں گنو(_اردو_جماعتیں):
            کل, درست = جوڑ(جدول[مقام]), جدول[مقام][مقام]
            مصنف.writerow([نام, کل, درست, کل - درست, درست / کل, درست * 100 / کل])


فنکشن اردو_رپورٹ_لکھو(منزل, اطلاع, جدول):
    فنکشن عدد(قدر):
        واپس str(قدر).translate(_اردو_ہندسے)
    آزمائشی_فیصد = عدد(format(اطلاع["test_accuracy"] * 100, ".2f") + "%")
    توثیقی_فیصد = عدد(format(اطلاع["best_val_accuracy"] * 100, ".2f") + "%")
    سطور = [
        "# اردو ریسنیٹ: ایس ٹی ایل ۱۰ کے مکمل نتائج", "",
        f"آخری آزمائشی درستگی **{آزمائشی_فیصد}** ہے۔ اصل آزمائشی مجموعے کی **{عدد(اطلاع['test_count'])}** تصاویر میں **{عدد(اطلاع['test_correct'])}** پیشگوئیاں درست ہیں۔", "",
        f"تربیت کے **{عدد(اطلاع['epochs'])}** ادوار مکمل ہوئے۔ توثیق کی سب سے زیادہ درستگی والا پہلا دور **{عدد(اطلاع['best_epoch'])}** منتخب ہوا؛ توثیقی درستگی **{توثیقی_فیصد}** ہے۔", "",
        "تربیت میں ۴۰۰۰، توثیق میں ۱۰۰۰، اور الگ آخری آزمائش میں ۸۰۰۰ تصاویر ہیں۔ اوسط اور معیاری انحراف صرف تربیتی تصاویر سے نکالے گئے۔ پہلے سے تربیت یافتہ وزن استعمال نہیں ہوئے۔ یہ ایک مقررہ طبقاتی تقسیم کا تجربہ ہے؛ معیاری دس فولڈ کا نتیجہ نہیں۔", "",
        "اصل نشان زدہ چاروں فائلیں اپنے سرکاری ہیش سے ملتی ہیں۔ مکمل محفوظہ کی جانچ کا دعویٰ نہیں کیا گیا؛ بے نشان تصاویر استعمال نہیں ہوئیں۔ محفوظ وزن کی دوبارہ لوڈ جانچ میں فرق صفر ہے۔", "",
        "## تربیت اور توثیق", "", "![تربیت اور توثیق کے اردو خاکے](خاکے/تربیتی_خاکے.png)", "",
        "## حقیقی جماعت اور پیشگوئی", "", "![آزمائشی الجھاؤ جدول](خاکے/الجھاؤ_جدول.png)", "",
        "## ہر جماعت کی بازیافت", "", "![ہر حقیقی جماعت کی درست پیشگوئیوں کا تناسب](خاکے/جماعتی_درستگی.png)", "",
        "| جماعت | کل تصاویر | درست پیشگوئیاں | بازیافت |", "|---|---:|---:|---:|",
    ]
    ہر مقام, نام میں گنو(_اردو_جماعتیں):
        کل, درست = جوڑ(جدول[مقام]), جدول[مقام][مقام]
        سطور.append(f"| {نام} | {عدد(کل)} | {عدد(درست)} | {عدد(f'{درست * 100 / کل:.2f}%')} |")
    سطور.extend(["", "بازیافت سے مراد اسی حقیقی جماعت کی تصاویر میں درست پیشگوئیوں کا تناسب ہے۔", "", "## تصویری مثالیں", "", "![آزمائشی تصاویر کی اردو پیشگوئیاں](خاکے/پیشگوئیاں.png)", "", "حسابی جانچ کا مکمل ثبوت [تصدیق.json](تصدیق.json)، [الجھاؤ جدول](الجھاؤ_جدول.csv) اور [جماعتی نتائج](جماعتی_نتائج.csv) میں محفوظ ہے۔", ""])
    (منزل / "نتائج.md").write_text("\n".join(سطور), encoding="utf-8")


فنکشن محفوظ_نتیجہ_جانچو(results):
    منزل = Path(results).resolve()
    ترتیب = پڑھو(منزل / "ترتیب.json")
    ثبوت_چاہیے(ترتیب.get("status") == "مکمل", "نتائج کی جانچ صرف مکمل تربیت کے بعد ہو سکتی ہے۔")
    اطلاع = پڑھو(منزل / "خلاصہ.json")
    تاریخ = پڑھو(منزل / "تاریخ.json")
    تقسیم = پڑھو(منزل / "تقسیم.json")
    پیشگوئیاں = پڑھو(منزل / "پیشگوئیاں.json")
    ثبوت_چاہیے(type(ترتیب.get("epochs")) ہے int اور ترتیب["epochs"] == 50 اور اطلاع["epochs"] == 50, "اس تجربے کے پچاس مکمل دور ضروری ہیں۔")
    ثبوت_چاہیے(لمبائی(تاریخ) == ترتیب["epochs"] اور [سطر["epoch"] ہر سطر میں تاریخ] == list(range(1, 51)) اور all(type(سطر["epoch"]) ہے int ہر سطر میں تاریخ), "دور منفرد اور ترتیب سے ایک تا پچاس ہونے چاہییں۔")
    ہر چابی میں ("image_size", "base_width", "seed", "device", "torch", "python"):
        ثبوت_چاہیے(اطلاع[چابی] == ترتیب[چابی], f"ترتیب اور رپورٹ میں فرق ہے: {چابی}")
    ہر سطر میں تاریخ:
        ہر چابی میں ("train_loss", "val_loss", "lr", "seconds"):
            ثبوت_چاہیے(محدود_عدد(سطر[چابی]), f"تربیتی تاریخ کا عدد درست نہیں: {چابی}")
        ہر چابی میں ("train_accuracy", "val_accuracy"):
            ثبوت_چاہیے(محدود_عدد(سطر[چابی], زیادہ=1), f"تاریخ کی درستگی صحیح نہیں: {چابی}")
    ثبوت_چاہیے((اطلاع["train_count"], اطلاع["val_count"], اطلاع["test_count"]) == (4000, 1000, 8000), "تصاویر کی تقسیم ۴۰۰۰، ۱۰۰۰، ۸۰۰۰ ہونی چاہیے۔")
    ہر ریکارڈ میں (اطلاع, تقسیم):
        ثبوت_چاہیے(ریکارڈ["class_names"] == _انگریزی_جماعتیں اور ریکارڈ["class_names_urdu"] == _اردو_جماعتیں, "جماعتوں کے نام یا سرکاری ترتیب مختلف ہیں۔")
    اصل_جڑ = Path(ترتیب["data_dir"]) / "stl10_binary"
    اصل_ثبوت = {}
    ہر نام, متوقع میں _اصل_جانچ.items():
        راستہ = اصل_جڑ / نام
        حاصل = فائل_ہیش(راستہ, algorithm="md5")
        ثبوت_چاہیے(حاصل == متوقع, f"اصل فائل کا سرکاری ہیش نہیں ملا: {نام}")
        اصل_ثبوت[نام] = {"md5": حاصل, "bytes": راستہ.stat().st_size}
    تربیتی_نشان = [قدر - 1 ہر قدر میں (اصل_جڑ / "train_y.bin").read_bytes()]
    آزمائشی_نشان = [قدر - 1 ہر قدر میں (اصل_جڑ / "test_y.bin").read_bytes()]
    ثبوت_چاہیے(لمبائی(تربیتی_نشان) == 5000 اور Counter(تربیتی_نشان) == Counter({مقام: 500 ہر مقام میں حد(10)}), "اصل تربیتی نشان کی تعداد یا ترتیب درست نہیں۔")
    ثبوت_چاہیے(لمبائی(آزمائشی_نشان) == 8000 اور Counter(آزمائشی_نشان) == Counter({مقام: 800 ہر مقام میں حد(10)}), "اصل آزمائشی نشان کی تعداد درست نہیں۔")
    تربیت, توثیق = تقسیم["train_indices"], تقسیم["validation_indices"]
    ثبوت_چاہیے(لمبائی(تربیت) == 4000 اور لمبائی(توثیق) == 1000, "تقسیم میں اشاریوں کی تعداد درست نہیں۔")
    ثبوت_چاہیے(all(type(مقام) ہے int اور 0 <= مقام < 5000 ہر مقام میں تربیت + توثیق), "تقسیم کا اشاریہ مقررہ حد میں صحیح عدد ہو۔")
    ثبوت_چاہیے(لمبائی(set(تربیت)) == 4000 اور لمبائی(set(توثیق)) == 1000 اور نہیں (set(تربیت) & set(توثیق)) اور set(تربیت) | set(توثیق) == set(range(5000)), "تربیتی اور توثیقی تقسیم الگ اور اصل ۵۰۰۰ تصاویر کو مکمل ڈھانپے۔")
    ثبوت_چاہیے(Counter(تربیتی_نشان[مقام] ہر مقام میں تربیت) == Counter({مقام: 400 ہر مقام میں حد(10)}), "تربیت میں ہر جماعت کی ۴۰۰ تصاویر ہوں۔")
    ثبوت_چاہیے(Counter(تربیتی_نشان[مقام] ہر مقام میں توثیق) == Counter({مقام: 100 ہر مقام میں حد(10)}), "توثیق میں ہر جماعت کی ۱۰۰ تصاویر ہوں۔")
    ثبوت_چاہیے(پیشگوئیاں["targets"] == آزمائشی_نشان, "محفوظ حقیقی جماعتیں اصل آزمائشی فائل کی عین ترتیب سے نہیں ملتیں۔")
    ثبوت_چاہیے(لمبائی(پیشگوئیاں["predictions"]) == 8000 اور لمبائی(پیشگوئیاں["probabilities"]) == 8000 اور all(محدود_عدد(قدر, زیادہ=1) ہر قدر میں پیشگوئیاں["probabilities"]), "آزمائشی پیشگوئیوں یا اعتماد کی تعداد اور قدریں درست نہیں۔")
    جدول = الجھاؤ_گنو(پیشگوئیاں["targets"], پیشگوئیاں["predictions"])
    کل = جوڑ(جوڑ(صف) ہر صف میں جدول)
    درست = جوڑ(جدول[مقام][مقام] ہر مقام میں حد(10))
    ثبوت_چاہیے(کل == 8000 اور all(جوڑ(صف) == 800 ہر صف میں جدول), "الجھاؤ جدول میں کل ۸۰۰۰ اور ہر حقیقی جماعت میں ۸۰۰ تصاویر ہوں۔")
    ثبوت_چاہیے(اطلاع["test_correct"] == درست اور محدود_عدد(اطلاع["test_accuracy"], زیادہ=1) اور math.isclose(اطلاع["test_accuracy"], درست / کل, rel_tol=0, abs_tol=1e-12), "رپورٹ کی آزمائشی درستگی محفوظ پیشگوئیوں کے آزاد حساب سے مختلف ہے۔")
    بہترین_دور, بہترین_درستگی = بہترین_دور_چنو(تاریخ)
    ثبوت_چاہیے(اطلاع["best_epoch"] == بہترین_دور اور math.isclose(اطلاع["best_val_accuracy"], بہترین_درستگی, rel_tol=0, abs_tol=1e-12), "منتخب دور توثیق کی سب سے زیادہ درستگی کا پہلا دور ہونا چاہیے۔")
    ثبوت_چاہیے(محدود_عدد(اطلاع["checkpoint_max_abs_error"]) اور اطلاع["checkpoint_max_abs_error"] == 0, "محفوظ وزن کی دوبارہ لوڈ جانچ کا فرق صفر ہونا چاہیے۔")
    وزن_جانچ = فائل_ہیش(منزل / "بہترین_وزن.pt")
    ثبوت_چاہیے(وزن_جانچ == اطلاع["checkpoint_sha256"], "منتخب محفوظ وزن کا ہیش رپورٹ سے مختلف ہے۔")
    ماخذ_جانچ = اطلاع["source_hashes"]
    ثبوت_چاہیے(isinstance(ماخذ_جانچ, dict) اور {"ماڈل.urdu", "اعداد.urdu", "تربیت.urdu", "خاکے.urdu"}.issubset(ماخذ_جانچ), "بنیادی اردو ماخذ کے ہیش مکمل نہیں۔")
    ہر نام, متوقع میں ماخذ_جانچ.items():
        ثبوت_چاہیے(Path(نام).name == نام اور Path(نام).suffix == ".urdu", "ماخذ فائل کا محفوظ نام درست نہیں۔")
        ثبوت_چاہیے(فائل_ہیش(Path(__file__).parent / نام) == متوقع, f"تربیت کے بعد اردو ماخذ بدل گیا: {نام}")
    خاکوں_کا_ثبوت = خاکے_جانچو(منزل, اطلاع["plots"])
    فی_جماعت = [{"class": نام, "total": 800, "correct": جدول[مقام][مقام], "recall": جدول[مقام][مقام] / 800} ہر مقام, نام میں گنو(_اردو_جماعتیں)]
    ثبوت = {"status": "PASS", "verified_at_utc": datetime.now(timezone.utc).isoformat(), "audit_method": "independent saved-metadata and raw-label audit; no inference or test tuning", "epochs": 50, "train_count": 4000, "validation_count": 1000, "test_count": 8000, "split_disjoint_complete": سچ, "train_class_count_each": 400, "validation_class_count_each": 100, "official_test_target_order_exact": سچ, "four_labeled_files_verified": سچ, "full_archive_verified": جھوٹ, "unlabeled_used": جھوٹ, "standard_ten_fold_protocol": جھوٹ, "raw_files": اصل_ثبوت, "confusion_orientation": "true rows, predicted columns", "confusion_matrix": جدول, "test_correct": درست, "test_accuracy": درست / کل, "per_class": فی_جماعت, "best_epoch": بہترین_دور, "best_val_accuracy": بہترین_درستگی, "best_epoch_selection": "earliest epoch with maximum validation accuracy", "checkpoint_max_abs_error": 0, "checkpoint_sha256": وزن_جانچ, "source_hashes_verified": ماخذ_جانچ, "plots": خاکوں_کا_ثبوت, "visual_review": "separate human/integrator visual review; this verifier checks image decoding and SVG XML"}
    جدول_محفوظ_کرو(منزل, جدول)
    اردو_رپورٹ_لکھو(منزل, اطلاع, جدول)
    (منزل / "تصدیق.json").write_text(json.dumps(ثبوت, indent=2, ensure_ascii=جھوٹ, allow_nan=جھوٹ) + "\n", encoding="utf-8")
    واپس ثبوت


فنکشن نتیجہ_جانچو(results):
    منزل = Path(results).resolve()
    کوشش:
        واپس محفوظ_نتیجہ_جانچو(منزل)
    سوائے Exception بطور خطا:
        # دوبارہ جانچ ناکام ہو تو پرانی کامیابی موجودہ ثبوت نہیں رہ سکتی۔
        اگر (منزل / "تصدیق.json").is_file():
            ناکامی = {"status": "FAIL", "verified_at_utc": datetime.now(timezone.utc).isoformat(), "reason": str(خطا), "audit_method": "independent saved-metadata and raw-label audit; no inference or test tuning"}
            (منزل / "تصدیق.json").write_text(json.dumps(ناکامی, ensure_ascii=جھوٹ, indent=2) + "\n", encoding="utf-8")
        اٹھاؤ


فنکشن چلائیں():
    دلائل = argparse.ArgumentParser(description=__doc__)
    دلائل.add_argument("--results", type=Path, default=Path(__file__).parent / "نتائج" / "ابتدائی_تربیت")
    اختیار = دلائل.parse_args()
    ثبوت = نتیجہ_جانچو(اختیار.results)
    دکھاؤ(f"جانچ کامیاب: {ثبوت['test_correct']}/{ثبوت['test_count']} درست، منتخب دور {ثبوت['best_epoch']}۔")


اگر __name__ == "__main__":
    چلائیں()
