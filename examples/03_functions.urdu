# /، *args، keyword-only، **kwargs اور واپس بمقابلہ آؤٹ پٹ
فنکشن بل(قیمت: int, /, تعداد: int = 1, *اضافی: int,
          رعایت: int = 0, **تفصیل: str) -> dict:
    کل = قیمت * تعداد + sum(اضافی) - رعایت
    واپس {"amount": کل, "label": تفصیل.get("نام", "عام")}

فنکشن سلام(نام, *, سابقہ="سلام"):
    واپس سابقہ + " " + نام

فنکشن شامل_کرو(عدد, اعداد=کچھ_نہیں):
    اگر اعداد ہے کچھ_نہیں:
        اعداد = []
    اعداد.append(عدد)
    واپس اعداد

فنکشن صرف_دکھاؤ(پیغام):
    دکھاؤ(پیغام)

فنکشن عارضی():
    گزر

بل_نتیجہ = بل(100, 2, 5, رعایت=10, نام="کتاب")
ڈیفالٹ = بل(100)
پہلی = شامل_کرو(1)
دوسری = شامل_کرو(2)
آؤٹ_پٹ_کا_جواب = صرف_دکھاؤ("کام مکمل")

کوشش:
    بل(قیمت=100)
سوائے TypeError:
    جگہ_کی_غلطی = "TypeError"
ورنہ:
    جگہ_کی_غلطی = "missing error"

کوشش:
    سلام("سارہ", "محترمہ")
سوائے TypeError:
    نام_کی_غلطی = "TypeError"
ورنہ:
    نام_کی_غلطی = "missing error"

RESULT = {
    "bill": بل_نتیجہ,
    "default": ڈیفالٹ,
    "unpacked": بل(*[50, 2], **{"رعایت": 5}),
    "greeting": سلام("سارہ", سابقہ="خوش آمدید"),
    "fresh_lists": [پہلی, دوسری],
    "output_returns_none": آؤٹ_پٹ_کا_جواب ہے کچھ_نہیں,
    "pass_returns_none": عارضی() ہے کچھ_نہیں,
    "argument_errors": [جگہ_کی_غلطی, نام_کی_غلطی],
}
دکھاؤ(بل_نتیجہ["amount"], بل_نتیجہ["label"])
دکھاؤ(RESULT["greeting"])
