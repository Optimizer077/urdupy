# اردوپائی: مکمل
"""محفوظ اردو نتائج سے خاکے دوبارہ بنائیں؛ نئی تربیت اور مواد کی تنزیل نہیں ہوتی۔"""
سے راستے درآمد راستہ بطور فائل_راستہ
سے اردوپائی.احکام درآمد اردو_دلائل_تجزیہ_کار
سے خاکے درآمد خاکے_بناؤ
سے جانچ درآمد پڑھو, نتیجہ_جانچو


فنکشن دوبارہ_بناؤ(نتائج):
    منزل = فائل_راستہ(نتائج).مکمل_راستہ()
    تاریخ = پڑھو(منزل / ("تاریخ" + جیسن_توسیع))
    خلاصہ = پڑھو(منزل / ("خلاصہ" + جیسن_توسیع))
    پیشگوئیاں = پڑھو(منزل / ("پیشگوئیاں" + جیسن_توسیع))
    اگر (منزل / ("نمونہ_تصاویر" + وزن_توسیع)).فائل_ہے():
        درآمد ٹارچ
        نمونے = ٹارچ.لوڈ(منزل / ("نمونہ_تصاویر" + وزن_توسیع), مقام_نقشہ=مرکزی_آلہ, صرف_وزن=سچ)
        پیشگوئیاں.تازہ(نمونے)
    راستے = خاکے_بناؤ(تاریخ, خلاصہ, پیشگوئیاں, منزل)
    نتیجہ_جانچو(منزل)
    واپس راستے


فنکشن چلائیں():
    تجزیہ = اردو_دلائل_تجزیہ_کار(پروگرام="اردو خاکے دوبارہ بنائیں", وضاحت_متن=دستاویز_متن)
    تجزیہ.دلیل_شامل("--نتائج", دلیل_قسم=فائل_راستہ, لازم=سچ)
    اختیار = تجزیہ.دلائل_پڑھو()
    راستے = دوبارہ_بناؤ(اختیار.نتائج)
    دکھاؤ("محفوظ تصویری فائلوں کی تعداد:", لمبائی(راستے))


اگر نام_ماڈیول == مرکزی_نام:
    چلائیں()
