# اردوپائی: مکمل
درآمد ٹارچ


کلاس بنیادی_بلاک(ٹارچ.عصبی.جزو):
    """دو پیچشیں اور باقیاتی راستہ۔"""
    فنکشن آغاز(خود, آمد_چینل, اخراج_چینل, چھلانگ=1):
        بالائی().آغاز()
        خود.پہلی = ٹارچ.عصبی.پیچش۲(
            آمد_چینل, اخراج_چینل, 3, قدم_فاصلہ=چھلانگ, حاشیہ=1, تعصب=جھوٹ)
        خود.پہلا_معمول = ٹارچ.عصبی.بیچ_معمول۲(اخراج_چینل)
        خود.دوسری = ٹارچ.عصبی.پیچش۲(
            اخراج_چینل, اخراج_چینل, 3, حاشیہ=1, تعصب=جھوٹ)
        خود.دوسرا_معمول = ٹارچ.عصبی.بیچ_معمول۲(اخراج_چینل)
        خود.فعالساز = ٹارچ.عصبی.ریلو()
        اگر چھلانگ != 1 یا آمد_چینل != اخراج_چینل:
            خود.مختصر_راستہ = ٹارچ.عصبی.تسلسلی(
                ٹارچ.عصبی.پیچش۲(
                    آمد_چینل, اخراج_چینل, 1, قدم_فاصلہ=چھلانگ, تعصب=جھوٹ),
                ٹارچ.عصبی.بیچ_معمول۲(اخراج_چینل))
        ورنہ:
            خود.مختصر_راستہ = ٹارچ.عصبی.شناخت()

    فنکشن آگے(خود, آمد):
        باقیات = خود.مختصر_راستہ(آمد)
        نتیجہ = خود.فعالساز(خود.پہلا_معمول(خود.پہلی(آمد)))
        نتیجہ = خود.دوسرا_معمول(خود.دوسری(نتیجہ))
        واپس خود.فعالساز(نتیجہ + باقیات)


کلاس ریس_نیٹ(ٹارچ.عصبی.جزو):
    """اٹھارہ تہوں کی باقیاتی بناوٹ؛ ہر مرحلے میں دو بلاک۔"""
    فنکشن آغاز(خود, زمرے=10, چوڑائی=64):
        بالائی().آغاز()
        تصدیق زمرے > 0 اور چوڑائی > 0
        خود.موجودہ_چینل = چوڑائی
        خود.ابتدائی = ٹارچ.عصبی.تسلسلی(
            ٹارچ.عصبی.پیچش۲(3, چوڑائی, 3, حاشیہ=1, تعصب=جھوٹ),
            ٹارچ.عصبی.بیچ_معمول۲(چوڑائی), ٹارچ.عصبی.ریلو())
        خود.پہلا_مرحلہ = خود.مرحلہ_بناؤ(چوڑائی, 1)
        خود.دوسرا_مرحلہ = خود.مرحلہ_بناؤ(چوڑائی * 2, 2)
        خود.تیسرا_مرحلہ = خود.مرحلہ_بناؤ(چوڑائی * 4, 2)
        خود.چوتھا_مرحلہ = خود.مرحلہ_بناؤ(چوڑائی * 8, 2)
        خود.اوسط_تالاب = ٹارچ.عصبی.موافق_اوسط_تالاب۲((1, 1))
        خود.درجہ_بند = ٹارچ.عصبی.خطی(چوڑائی * 8, زمرے)

    فنکشن مرحلہ_بناؤ(خود, چینل, چھلانگ):
        پہلا = بنیادی_بلاک(خود.موجودہ_چینل, چینل, چھلانگ)
        خود.موجودہ_چینل = چینل
        واپس ٹارچ.عصبی.تسلسلی(پہلا, بنیادی_بلاک(چینل, چینل))

    فنکشن آگے(خود, آمد):
        نتیجہ = خود.ابتدائی(آمد)
        نتیجہ = خود.پہلا_مرحلہ(نتیجہ)
        نتیجہ = خود.دوسرا_مرحلہ(نتیجہ)
        نتیجہ = خود.تیسرا_مرحلہ(نتیجہ)
        نتیجہ = خود.چوتھا_مرحلہ(نتیجہ)
        واپس خود.درجہ_بند(ٹارچ.ہموار(خود.اوسط_تالاب(نتیجہ), 1))


اگر نام_ماڈیول == مرکزی_نام:
    ٹارچ.دھاگے_مقرر(1)
    ٹارچ.بیج_مقرر(7)
    ماڈل = ریس_نیٹ(چوڑائی=8).منتقل(مرکزی_آلہ)
    آمد = ٹارچ.اتفاقی_معمول(2, 3, 32, 32, آلہ=مرکزی_آلہ)
    ہدف = ٹارچ.ٹینسر([1, 2], قسم_اعداد=ٹارچ.صحیح۶۴)
    نتیجہ = ماڈل(آمد)
    نقصان = ٹارچ.عصبی.درجہ_نقصان()(نتیجہ, ہدف)
    نقصان.پیچھے()
    دکھاؤ("ریسنیٹ کی شکل:", فہرست(نتیجہ.شکل), "نقصان:", نقصان.عدد_لو())
