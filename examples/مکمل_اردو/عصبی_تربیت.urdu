# اردوپائی: مکمل
درآمد ٹارچ


کلاس چھوٹا_ماڈل(ٹارچ.عصبی.جزو):
    """ایک حقیقی خطی تہہ؛ آغاز اور آگے بھی اردو میں۔"""
    فنکشن آغاز(خود):
        بالائی().آغاز()
        خود.تہہ = ٹارچ.عصبی.خطی(1, 1)

    فنکشن آگے(خود, آمد):
        واپس خود.تہہ(آمد)


فنکشن سکھاؤ(طریقہ="ایڈم", ادوار=120):
    تصدیق ادوار > 0
    ٹارچ.بیج_مقرر(7)
    آمد = ٹارچ.اتفاقی_معمول(32, 1, آلہ=مرکزی_آلہ)
    ہدف = 2 * آمد - 0.5
    ماڈل = چھوٹا_ماڈل().منتقل(مرکزی_آلہ)
    اگر طریقہ == "تدریجی":
        بہترکار = ٹارچ.اصلاح.اتفاقی_تدریجی_نزول(
            ماڈل.پیرامیٹر(), شرح_تعلم=0.08, رفتار_یادداشت=0.9)
    ورنہ:
        تصدیق طریقہ == "ایڈم"
        بہترکار = ٹارچ.اصلاح.ایڈم_ڈبلیو(
            ماڈل.پیرامیٹر(), شرح_تعلم=0.08, وزن_زوال=0.0)
    معیار = ٹارچ.عصبی.مربع_نقصان()
    تاریخ = []
    ہر دور میں حد(ادوار):
        بہترکار.صفر_تدریج(صفر_کے_بجائے_عدم=سچ)
        نقصان = معیار(ماڈل(آمد), ہدف)
        تاریخ.آخر_لگاؤ(نقصان.عدد_لو())
        نقصان.پیچھے()
        اگر دور == 0:
            پہلا_تدریج = ماڈل.تہہ.وزن_پیرامیٹر.تدریج.الگ().نقل_ٹینسر()
        بہترکار.قدم()
    ماڈل.جانچ()
    ساتھ ٹارچ.بلا_تدریج():
        تاریخ.آخر_لگاؤ(معیار(ماڈل(آمد), ہدف).عدد_لو())
    واپس ماڈل, تاریخ, آمد, ہدف, پہلا_تدریج


فنکشن محفوظ_اور_واپس(ماڈل, آمد, مقام):
    ٹارچ.محفوظ(ماڈل.حالت_لغت(), مقام)
    بحال = چھوٹا_ماڈل().منتقل(مرکزی_آلہ)
    بحال.حالت_لوڈ(ٹارچ.لوڈ(
        مقام, مقام_نقشہ=مرکزی_آلہ, صرف_وزن=سچ))
    بحال.جانچ()
    ساتھ ٹارچ.بلا_تدریج():
        تصدیق ٹارچ.برابر(بحال(آمد), ماڈل(آمد))
    واپس بحال


اگر نام_ماڈیول == مرکزی_نام:
    ماڈل, تاریخ, آمد, ہدف, پہلا_تدریج = سکھاؤ()
    محفوظ_اور_واپس(ماڈل, آمد, "سیکھے_ہوئے_وزن")
    دکھاؤ("پہلا نقصان:", تاریخ[0], "آخری نقصان:", تاریخ[-1])
