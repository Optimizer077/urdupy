# اردوپائی: مکمل
درآمد نمپی


فنکشن حساب():
    """اصل عددی سرنیاں، خودکار پھیلاؤ اور خطی مساوات۔"""
    اعداد = نمپی.عددی_حد(6, قسم_اعداد=نمپی.اعشاری۶۴).نئی_شکل(2, 3)
    نتیجہ = اعداد + نمپی.سرنی([10, 20, 30], قسم_اعداد=نمپی.اعشاری۶۴)
    ضرائب = نمپی.سرنی([[3, 1], [1, 2]], قسم_اعداد=نمپی.اعشاری۶۴)
    دایاں = نمپی.سرنی([9, 8], قسم_اعداد=نمپی.اعشاری۶۴)
    جواب = نمپی.خطی_الجبر.حل(ضرائب, دایاں)
    تصدیق نمپی.سب_قریب(ضرائب @ جواب, دایاں)
    واپس {"سرنی": نتیجہ, "اوسط": نتیجہ.اوسط(), "جواب": جواب}


اگر نام_ماڈیول == مرکزی_نام:
    نتائج = حساب()
    دکھاؤ("سرنی:", نتائج["سرنی"].فہرست_میں())
    دکھاؤ("اوسط:", نتائج["اوسط"])
    دکھاؤ("جواب:", نتائج["جواب"].فہرست_میں())
