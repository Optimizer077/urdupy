# 3 چھوڑ دیں، 4 کے بعد لوپ روک دیں
رکھے = []
ہر عدد میں حد(1, 7):
    اگر عدد == 3:
        جاری
    اگر عدد > 4:
        روکو
    رکھے.append(عدد)

مربع = [عدد * عدد ہر عدد میں حد(1, 4)]
باقی = 3
الٹی_گنتی = []
جب_تک باقی > 0:
    الٹی_گنتی.append(باقی)
    باقی -= 1

RESULT = {"kept": رکھے, "sum": جوڑ(رکھے), "squares": مربع, "countdown": الٹی_گنتی}
دکھاؤ(رکھے, جوڑ(رکھے))
دکھاؤ(مربع, الٹی_گنتی)
