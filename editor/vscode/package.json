{
  "name": "urdupy-local",
  "displayName": "UrduPy local syntax",
  "description": "Local TextMate syntax highlighting for .urdu source files",
  "version": "0.1.0",
  "publisher": "urdupy-local",
  "license": "MIT",
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "urdupy",
        "aliases": ["UrduPy", "urdupy"],
        "extensions": [".urdu"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "urdupy",
        "scopeName": "source.urdupy",
        "path": "./syntaxes/urdupy.tmLanguage.json"
      }
    ]
  }
}
