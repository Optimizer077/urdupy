# اردوپائی: مکمل
"""محفوظ مکمل اردو ریسنیٹ سے تصویر کی جماعت اور امکانات بتائیں۔"""

درآمد جیسن
درآمد ٹارچ
سے اردوپائی.احکام درآمد اردو_دلائل_تجزیہ_کار
سے راستے درآمد راستہ
سے تصاویر درآمد تصویر
سے بصارت درآمد تبدیلیاں
سے ماڈل درآمد ریسنیٹ۱۸


فنکشن اطلاع_ہم_آہنگ(اطلاع):
    """نئی اردو اطلاع اور تاریخی نتائج دونوں کے پیمانے قابل استعمال ہیں۔"""
    اگر "جماعتیں" میں اطلاع:
        واپس اطلاع
    واپس {
        "جماعتیں": اطلاع[اصل_متن("متن_۹۹_۱۰۸_۹۷_۱۱۵_۱۱۵_۹۵_۱۱۰_۹۷_۱۰۹_۱۰۱_۱۱۵_۹۵_۱۱۷_۱۱۴_۱۰۰_۱۱۷")],
        "چوڑائی": اطلاع[اصل_متن("متن_۹۸_۹۷_۱۱۵_۱۰۱_۹۵_۱۱۹_۱۰۵_۱۰۰_۱۱۶_۱۰۴")],
        "جسامت": اطلاع[اصل_متن("متن_۱۰۵_۱۰۹_۹۷_۱۰۳_۱۰۱_۹۵_۱۱۵_۱۰۵_۱۲۲_۱۰۱")],
        "اوسط": اطلاع[اصل_متن("متن_۱۰۹_۱۰۱_۹۷_۱۱۰")],
        "انحراف": اطلاع[اصل_متن("متن_۱۱۵_۱۱۶_۱۰۰")],
    }


فنکشن تصویر_تیار_کرو(تصویر_راستہ, اطلاع):
    """پہلے آٹھ بٹ ٹینسر کی جسامت بدلیں، پھر اصل تربیتی پیمانے لگائیں۔"""
    اطلاع = اطلاع_ہم_آہنگ(اطلاع)
    تبدیلی_زنجیر = تبدیلیاں.مرکب([
        تبدیلیاں.تصویر_سے_ٹینسر(),
        تبدیلیاں.حجم_تبدیلی((اطلاع["جسامت"], اطلاع["جسامت"]), کنارے_ہموار=سچ),
        تبدیلیاں.اعداد_قسم_بدلو(ٹارچ.اعشاری۳۲),
        تبدیلیاں.معمول_تبدیلی(اطلاع["اوسط"], اطلاع["انحراف"]),
    ])
    ساتھ تصویر.کھولو(تصویر_راستہ) بطور عکس:
        واپس تبدیلی_زنجیر(عکس.بدلو(سرخ_سبز_نیلا)).بعد_بڑھاؤ(0)


فنکشن پیشگوئی_کرو(تصویر_راستہ, نتائج_جڑ, تعداد=3):
    اگر نہیں مثال_ہے(تعداد, صحیح_عدد) یا مثال_ہے(تعداد, بولی) یا تعداد < 1:
        اٹھاؤ قدر_خطا("پیشگوئیوں کی تعداد مثبت صحیح عدد ہونی چاہیے۔")
    نتائج_جڑ = راستہ(نتائج_جڑ)
    اطلاع = اطلاع_ہم_آہنگ(جیسن.جیسن_پڑھو(
        (نتائج_جڑ / ("خلاصہ" + جیسن_توسیع)).متن_پڑھو(رمزبندی=متن_رمزبندی)))
    ماڈل = ریسنیٹ۱۸(جماعتیں=لمبائی(اطلاع["جماعتیں"]), چوڑائی=اطلاع["چوڑائی"])
    ماڈل.حالت_لوڈ(ٹارچ.لوڈ(
        نتائج_جڑ / ("بہترین_وزن" + وزن_توسیع),
        مقام_نقشہ=مرکزی_آلہ, صرف_وزن=سچ))
    ماڈل.جانچ()
    عکس = تصویر_تیار_کرو(تصویر_راستہ, اطلاع)
    ساتھ ٹارچ.استدلال_حالت():
        امکانات, اشاریے = ماڈل(عکس).نرم_زیادہ_عمل(بعد=1).بہترین_چند(
            کمترین(تعداد, لمبائی(اطلاع["جماعتیں"])), بعد=1)
    واپس [
        {"جماعت": اطلاع["جماعتیں"][مقام], "امکان": امکان}
        ہر مقام, امکان میں اکٹھا(اشاریے[0].فہرست_میں(), امکانات[0].فہرست_میں())
    ]


فنکشن چلائیں():
    تجزیہ_کار = اردو_دلائل_تجزیہ_کار(پروگرام="اردو پیشگوئی", وضاحت_متن=دستاویز_متن)
    تجزیہ_کار.دلیل_شامل("عکس", قسم=راستہ, مدد="اپنی تصویر کا راستہ")
    تجزیہ_کار.دلیل_شامل(
        "--نتائج", قسم=راستہ,
        طے_شدہ=راستہ(موجودہ_فائل).مکمل_راستہ().والد / "نتائج",
        مدد="محفوظ وزن اور خلاصے کا فولڈر")
    تجزیہ_کار.دلیل_شامل("--تعداد", قسم=صحیح_عدد, طے_شدہ=3, مدد="نمایاں جماعتوں کی تعداد")
    اختیار = تجزیہ_کار.دلائل_پڑھو()
    دکھاؤ(جیسن.جیسن_متن(
        پیشگوئی_کرو(اختیار.عکس, اختیار.نتائج, اختیار.تعداد),
        انگریزی_رمز_لازم=جھوٹ, آگے_فاصلہ=2))


اگر نام_ماڈیول == مرکزی_نام:
    چلائیں()

