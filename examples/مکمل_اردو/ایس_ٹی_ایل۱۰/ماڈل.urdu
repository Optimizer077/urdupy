# اردوپائی: مکمل
"""چھوٹی تصاویر کے لیے مکمل اردو ریسنیٹ اٹھارہ؛ پرانے وزن بھی بعینہ قابل استعمال ہیں۔"""

درآمد ٹارچ


کلاس بنیادی_بلاک(ٹارچ.عصبی.جزو):
    """دو پیچشی تہیں اور ضرورت کے مطابق باقیاتی راستہ۔"""

    فنکشن آغاز(خود, آنے_والے, جانے_والے, چھلانگ=1):
        بالائی().آغاز()
        خود.پہلی_پیچش = ٹارچ.عصبی.پیچش۲(
            آنے_والے, جانے_والے, گرہ_حجم=3, قدم_فاصلہ=چھلانگ,
            حاشیہ=1, تعصب=جھوٹ)
        خود.پہلی_معیاری_بندی = ٹارچ.عصبی.بیچ_معمول۲(جانے_والے)
        خود.فعالساز = ٹارچ.عصبی.ریلو(اندرونی_تبدیلی=سچ)
        خود.دوسری_پیچش = ٹارچ.عصبی.پیچش۲(
            جانے_والے, جانے_والے, گرہ_حجم=3, قدم_فاصلہ=1,
            حاشیہ=1, تعصب=جھوٹ)
        خود.دوسری_معیاری_بندی = ٹارچ.عصبی.بیچ_معمول۲(جانے_والے)
        # عددی املا پرانے وزن میں باقیاتی راستے کا اصل نام محفوظ رکھتی ہے۔
        اگر چھلانگ != 1 یا آنے_والے != جانے_والے:
            خود.اصل_۱۵۸۵_۱۵۷۵_۱۵۸۷_۱۵۷۸_۱۷۲۹ = ٹارچ.عصبی.تسلسلی(
                ٹارچ.عصبی.پیچش۲(
                    آنے_والے, جانے_والے, گرہ_حجم=1,
                    قدم_فاصلہ=چھلانگ, تعصب=جھوٹ),
                ٹارچ.عصبی.بیچ_معمول۲(جانے_والے))
        ورنہ:
            خود.اصل_۱۵۸۵_۱۵۷۵_۱۵۸۷_۱۵۷۸_۱۷۲۹ = ٹارچ.عصبی.شناخت()

    فنکشن آگے(خود, عکس):
        باقیات = خود.اصل_۱۵۸۵_۱۵۷۵_۱۵۸۷_۱۵۷۸_۱۷۲۹(عکس)
        حاصل = خود.فعالساز(خود.پہلی_معیاری_بندی(خود.پہلی_پیچش(عکس)))
        حاصل = خود.دوسری_معیاری_بندی(خود.دوسری_پیچش(حاصل))
        واپس خود.فعالساز(حاصل + باقیات)


کلاس ریس_نیٹ(ٹارچ.عصبی.جزو):
    """چار مرحلوں میں دو دو بلاک؛ ابتدائی پیچش چھوٹی تصویر کا حجم برقرار رکھتی ہے۔"""

    فنکشن آغاز(خود, جماعتیں=10, چوڑائی=64):
        بالائی().آغاز()
        اگر نہیں مثال_ہے(جماعتیں, صحیح_عدد) یا مثال_ہے(جماعتیں, بولی) یا جماعتیں <= 0:
            اٹھاؤ قدر_خطا("جماعتوں کی تعداد مثبت صحیح عدد ہونی چاہیے۔")
        اگر نہیں مثال_ہے(چوڑائی, صحیح_عدد) یا مثال_ہے(چوڑائی, بولی) یا چوڑائی <= 0:
            اٹھاؤ قدر_خطا("چوڑائی مثبت صحیح عدد ہونی چاہیے۔")
        خود.بنیادی_چوڑائی = چوڑائی
        خود.زمرے = جماعتیں
        خود.موجودہ_چینل = چوڑائی
        خود.ابتدائی_پیچش = ٹارچ.عصبی.پیچش۲(
            3, چوڑائی, گرہ_حجم=3, قدم_فاصلہ=1, حاشیہ=1, تعصب=جھوٹ)
        خود.ابتدائی_معیاری_بندی = ٹارچ.عصبی.بیچ_معمول۲(چوڑائی)
        خود.فعالساز = ٹارچ.عصبی.ریلو(اندرونی_تبدیلی=سچ)
        خود.پہلا_مرحلہ = خود.مرحلہ_بناؤ(چوڑائی, 1)
        خود.دوسرا_مرحلہ = خود.مرحلہ_بناؤ(چوڑائی * 2, 2)
        خود.تیسرا_مرحلہ = خود.مرحلہ_بناؤ(چوڑائی * 4, 2)
        خود.چوتھا_مرحلہ = خود.مرحلہ_بناؤ(چوڑائی * 8, 2)
        خود.اوسط_پول = ٹارچ.عصبی.موافق_اوسط_تالاب۲((1, 1))
        خود.درجہ_بند = ٹارچ.عصبی.خطی(چوڑائی * 8, جماعتیں)
        خود.ابتدائی_وزن_بھراؤ()

    فنکشن مرحلہ_بناؤ(خود, چینل, چھلانگ):
        پہلا = بنیادی_بلاک(خود.موجودہ_چینل, چینل, چھلانگ)
        خود.موجودہ_چینل = چینل
        واپس ٹارچ.عصبی.تسلسلی(پہلا, بنیادی_بلاک(چینل, چینل))

    فنکشن ابتدائی_وزن_بھراؤ(خود):
        ہر تہہ میں خود.تمام_اجزا():
            اگر مثال_ہے(تہہ, ٹارچ.عصبی.پیچش۲):
                ٹارچ.عصبی.ابتدائیہ.کائمنگ_معمول(
                    تہہ.وزن_پیرامیٹر, اسلوب=اخراج_شاخ, غیر_خطیت=ریلو_نام)
            ورنہ_اگر مثال_ہے(تہہ, ٹارچ.عصبی.بیچ_معمول۲):
                ٹارچ.عصبی.ابتدائیہ.اکائی_بھراؤ(تہہ.وزن_پیرامیٹر)
                ٹارچ.عصبی.ابتدائیہ.صفر_بھراؤ(تہہ.تعصب)

    فنکشن آگے(خود, عکس):
        حاصل = خود.فعالساز(خود.ابتدائی_معیاری_بندی(خود.ابتدائی_پیچش(عکس)))
        حاصل = خود.پہلا_مرحلہ(حاصل)
        حاصل = خود.دوسرا_مرحلہ(حاصل)
        حاصل = خود.تیسرا_مرحلہ(حاصل)
        حاصل = خود.چوتھا_مرحلہ(حاصل)
        واپس خود.درجہ_بند(ٹارچ.ہموار(خود.اوسط_پول(حاصل), 1))


فنکشن ریسنیٹ۱۸(جماعتیں=10, چوڑائی=64):
    """مکمل چوڑائی بنیادی انتخاب ہے؛ اصل ٹارچ ماڈل واپس ملتا ہے۔"""
    واپس ریس_نیٹ(جماعتیں=جماعتیں, چوڑائی=چوڑائی)

