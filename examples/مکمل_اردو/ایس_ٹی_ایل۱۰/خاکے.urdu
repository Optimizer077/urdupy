# اردوپائی: مکمل
"""حقیقی نتائج کے اردو خاکے؛ درستگی صفر تا ایک اور شمار اصل تصاویر کے ہیں۔"""
درآمد ریاضی
درآمد نظامی
سے راستے درآمد راستہ بطور فائل_راستہ
درآمد اردو_تشکیل
سے دو_سمتی_متن درآمد حاصل_نمائش
درآمد خاکہ_سازی
خاکہ_سازی.رسمی_پس_منظر(بلا_پردہ_خاکہ)
درآمد خاکہ بطور قلم
سے خاکہ_سازی درآمد خط_انتظام بطور خط_انتظام, اصل_۱۰۲_۱۱۶_۵۰_۱۰۲_۱۱۱_۱۱۰_۱۱۶ بطور حروف_محرك
سے اصل_۱۰۹_۹۷_۱۱۶_۱۱۲_۱۰۸_۱۱۱_۱۱۶_۱۰۸_۱۰۵_۹۸.رنگوں درآمد خطی_رنگ_نقشہ بطور رنگی_نقشہ
سے اصل_۱۰۹_۹۷_۱۱۶_۱۱۲_۱۰۸_۱۱۱_۱۱۶_۱۰۸_۱۰۵_۹۸.اصل_۱۱۶_۱۰۵_۹۹_۱۰۷_۱۰۱_۱۱۴ درآمد عددی_وضع بطور عدد_وضع_کار, صحیح_نشانات بطور صحیح_نشانات
درآمد نمپی بطور عددی_کتاب
_ہندسے = متن.ترجمہ_جدول('0123456789%', '۰۱۲۳۴۵۶۷۸۹٪')
_نیلا = اصل_متن('متن_۳۵_۵۰_۵۲_۵۳_۶۶_۵۶_۶۵')
_سنہری = اصل_متن('متن_۳۵_۶۶_۵۶_۵۵_۵۶_۴۹_۵۵')
_سیاہ = '#253444'
_سرمئی = اصل_متن('متن_۳۵_۵۴_۵۲_۵۵_۴۹_۵۵_۶۸')
_مقامی_ترتیب = بولی(خاصیت_لو(حروف_محرك, اصل_متن('متن_۹۵_۹۵_۱۰۸_۱۰۵_۹۸_۱۱۴_۹۷_۱۱۳_۱۰۹_۹۵_۱۱۸_۱۰۱_۱۱۴_۱۱۵_۱۰۵_۱۱۱_۱۱۰_۹۵_۹۵'), ''))

فنکشن اردو_متن(عبارت):
    """حقیقی نتائج کے اردو خاکے؛ درستگی صفر تا ایک اور شمار اصل تصاویر کے ہیں۔"""
    عبارت = متن(عبارت).ترجمہ_حروف(_ہندسے)
    اگر _مقامی_ترتیب:
        واپس عبارت
    واپس حاصل_نمائش(اردو_تشکیل.نئی_شکل(عبارت), اصل_۹۸_۹۷_۱۱۵_۱۰۱_۹۵_۱۰۰_۱۰۵_۱۱۴=اصل_متن('متن_۸۲'))

فنکشن اردو_عدد(عدد, مقام=0):
    اگر مطلق(عدد - گول(عدد)) < 0.0000001:
        واپس متن(گول(عدد)).ترجمہ_حروف(_ہندسے)
    واپس وضع(عدد, اصل_متن('متن_۱۰۳')).ترجمہ_حروف(_ہندسے)

فنکشن اردو_فیصد(عدد, مقام=0):
    واپس (وضع(عدد, اصل_متن('متن_۱۰۳')) + '٪').ترجمہ_حروف(_ہندسے)

فنکشن خط_چنو(اطلاع):
    """حقیقی نتائج کے اردو خاکے؛ درستگی صفر تا ایک اور شمار اصل تصاویر کے ہیں۔"""
    راستے = [اطلاع.لو('خط_راستہ'), نظامی.اصل_۱۰۱_۱۱۰_۱۱۸_۱۰۵_۱۱۴_۱۱۱_۱۱۰.لو(اصل_متن('متن_۸۵_۸۲_۶۸_۸۵_۸۰_۸۹_۹۵_۸۵_۸۲_۶۸_۸۵_۹۵_۷۰_۷۹_۷۸_۸۴'))]
    راستے.آخر_لگاؤ(فائل_راستہ(نظامی.اصل_۱۰۱_۱۱۰_۱۱۸_۱۰۵_۱۱۴_۱۱۱_۱۱۰.لو(اصل_متن('متن_۸۷_۷۳_۷۸_۶۸_۷۳_۸۲'), اصل_متن('متن_۶۷_۵۸_۴۷_۸۷_۱۰۵_۱۱۰_۱۰۰_۱۱۱_۱۱۹_۱۱۵'))) / اصل_متن('متن_۷۰_۱۱۱_۱۱۰_۱۱۶_۱۱۵') / اصل_متن('متن_۱۱۶_۹۷_۱۰۴_۱۱۱_۱۰۹_۹۷_۴۶_۱۱۶_۱۱۶_۱۰۲'))
    ہر راستہ میں راستے:
        اگر راستہ اور فائل_راستہ(راستہ).فائل_ہے():
            خط_انتظام.اصل_۱۰۲_۱۱۱_۱۱۰_۱۱۶_۷۷_۹۷_۱۱۰_۹۷_۱۰۳_۱۰۱_۱۱۴.اصل_۹۷_۱۰۰_۱۰۰_۱۰۲_۱۱۱_۱۱۰_۱۱۶(متن(راستہ))
            واپس خط_انتظام.اصل_۷۰_۱۱۱_۱۱۰_۱۱۶_۸۰_۱۱۴_۱۱۱_۱۱۲_۱۰۱_۱۱۴_۱۱۶_۱۰۵_۱۰۱_۱۱۵(اصل_۱۰۲_۱۱۰_۹۷_۱۰۹_۱۰۱=متن(راستہ)).اصل_۱۰۳_۱۰۱_۱۱۶_۹۵_۱۱۰_۹۷_۱۰۹_۱۰۱()
    ہر نام میں (اصل_متن('متن_۷۸_۱۱۱_۱۱۶_۱۱۱_۳۲_۷۸_۹۷_۱۱۵_۱۰۷_۱۰۴_۳۲_۶۵_۱۱۴_۹۷_۹۸_۱۰۵_۹۹'), اصل_متن('متن_۷۸_۱۱۱_۱۱۶_۱۱۱_۳۲_۸۳_۹۷_۱۱۰_۱۱۵_۳۲_۶۵_۱۱۴_۹۷_۹۸_۱۰۵_۹۹'), اردو_خط, اصل_متن('متن_۶۸_۱۰۱_۱۰۶_۹۷_۸۶_۱۱۷_۳۲_۸۳_۹۷_۱۱۰_۱۱۵')):
        کوشش:
            راستہ = خط_انتظام.اصل_۱۰۲_۱۰۵_۱۱۰_۱۰۰_۱۰۲_۱۱۱_۱۱۰_۱۱۶(نام, اصل_۱۰۲_۹۷_۱۰۸_۱۰۸_۹۸_۹۷_۹۹_۱۰۷_۹۵_۱۱۶_۱۱۱_۹۵_۱۰۰_۱۰۱_۱۰۲_۹۷_۱۱۷_۱۰۸_۱۱۶=جھوٹ)
            واپس خط_انتظام.اصل_۷۰_۱۱۱_۱۱۰_۱۱۶_۸۰_۱۱۴_۱۱۱_۱۱۲_۱۰۱_۱۱۴_۱۱۶_۱۰۵_۱۰۱_۱۱۵(اصل_۱۰۲_۱۱۰_۹۷_۱۰۹_۱۰۱=راستہ).اصل_۱۰۳_۱۰۱_۱۱۶_۹۵_۱۱۰_۹۷_۱۰۹_۱۰۱()
        سوائے قدر_خطا:
            جاری
    اٹھاؤ عملی_خطا(اصل_متن('متن_۱۵۷۵_۱۵۸۵_۱۵۸۳_۱۶۰۸_۳۲_۱۵۸۲_۱۵۹۱_۳۲_۱۶۰۶_۱۷۲۹_۱۷۴۰_۱۷۲۲_۳۲_۱۶۰۵_۱۶۰۴_۱۵۷۵_۱۵۶۳_۳۲_۸۵_۸۲_۶۸_۸۵_۸۰_۸۹_۹۵_۸۵_۸۲_۶۸_۸۵_۹۵_۷۰_۷۹_۷۸_۸۴_۳۲_۱۶۰۵_۱۷۴۰_۱۷۲۲_۳۲_۱۵۸۲_۱۵۹۱_۳۲_۱۷۰۵_۱۵۷۵_۳۲_۱۵۸۵_۱۵۷۵_۱۵۸۷_۱۵۷۸_۱۷۲۹_۳۲_۱۵۸۳_۱۷۴۰_۱۷۲۲_۱۷۴۸'))

فنکشن محور_سجاؤ(محور, فیصد=جھوٹ):
    محور.حاشیے[اصل_متن('متن_۱۱۶_۱۱۱_۱۱۲')].مرئی_کرو(جھوٹ)
    محور.حاشیے[اصل_متن('متن_۱۱۴_۱۰۵_۱۰۳_۱۰۴_۱۱۶')].مرئی_کرو(جھوٹ)
    محور.حاشیے[اصل_متن('متن_۱۰۸_۱۰۱_۱۰۲_۱۱۶')].رنگ_مقرر(اصل_متن('متن_۳۵_۶۵_۵۳_۶۵_۷۰_۶۶_۵۷'))
    محور.حاشیے[اصل_متن('متن_۹۸_۱۱۱_۱۱۶_۱۱۶_۱۱۱_۱۰۹')].رنگ_مقرر(اصل_متن('متن_۳۵_۶۵_۵۳_۶۵_۷۰_۶۶_۵۷'))
    محور.محور_اعداد(رنگوں=_سیاہ, لیبل_حجم=11)
    محور.نیچے_جالی(سچ)
    محور.جالی(محور=اصل_متن('متن_۱۲۱'), رنگ=اصل_متن('متن_۳۵_۶۹_۵۱_۶۹_۵۵_۶۹_۶۶'), خط_موٹائی=0.8)
    محور.افقی_محور.بڑے_نشان_وضع(عدد_وضع_کار(اردو_عدد))
    محور.عمودی_محور.بڑے_نشان_وضع(عدد_وضع_کار(اردو_فیصد اگر فیصد ورنہ اردو_عدد))

فنکشن محفوظ_کرو(شکل, منزل, نام):
    راستے = []
    کوشش:
        ہر توسیع میں (تصویر_توسیع, ویکٹر_توسیع):
            راستہ = منزل / (متن(نام) + توسیع)
            شکل.خاکہ_محفوظ(راستہ, نقطے_فی_انچ=170, حد_خانہ=باریک_حد, پس_منظر_رنگ=سفید_رنگ)
            راستے.آخر_لگاؤ(راستہ)
    آخرکار:
        قلم.بند(شکل)
    واپس راستے

فنکشن تربیتی_خاکہ(تاریخ, اطلاع, منزل):
    ادوار = عددی_کتاب.بطور_سرنی([سطر['دور'] ہر سطر میں تاریخ], قسم_اعداد=صحیح_عدد)
    شکل, محاور = قلم.ذیلی_خاکے(1, 2, خاکہ_حجم=(13.5, 6.2))
    شکل.محور_درستگی(بائیں=0.07, دائیں=0.98, نیچے=0.22, اوپر=0.79, افقی_خلاء=0.22)
    شکل.مجموعی_عنوان(اردو_متن('ریسنیٹ کی تربیت — ایس ٹی ایل ۱۰'), خط_حجم=22, عمودی_مقام=0.98)
    شکل.خاکہ_متن(0.5, 0.875, اردو_متن('ہر دور کے بعد تربیت اور توثیق کا موازنہ'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), رنگ=_سرمئی, خط_حجم=13)
    بہترین = اطلاع.لو('بہترین_دور')
    ہر محور, چابی, عنوان, لیبل, فیصد میں ((محاور[0], 'نقصان', 'نقصان', 'کراس اینٹروپی نقصان', جھوٹ), (محاور[1], 'درستگی', 'درستگی', 'درست پیشگوئیاں (٪)', سچ)):
        ضرب = 100 اگر فیصد ورنہ 1
        تربیت = [سطر['تربیتی_' + متن(چابی)] * ضرب ہر سطر میں تاریخ]
        توثیق = [سطر['توثیقی_' + متن(چابی)] * ضرب ہر سطر میں تاریخ]
        محور.خط_کھینچو(ادوار, تربیت, رنگ=_نیلا, خط_موٹائی=2.2, نشان_انداز=گول_نشان, نشان_حجم=4, نام_پٹی=اردو_متن('تربیت'))
        محور.خط_کھینچو(ادوار, توثیق, رنگ=_سنہری, خط_موٹائی=2.2, خط_انداز='--', نشان_انداز=اصل_متن('متن_۱۱۵'), نشان_حجم=4, نشان_بھرائی=سفید_رنگ, نام_پٹی=اردو_متن('توثیق'))
        اگر بہترین ہے نہیں کچھ_نہیں:
            محور.اصل_۹۷_۱۲۰_۱۱۸_۱۰۸_۱۰۵_۱۱۰_۱۰۱(بہترین, رنگ=_سرمئی, خط_موٹائی=1, خط_انداز=':', نام_پٹی=اردو_متن('منتخب دور: ' + متن(بہترین)))
        محور.عنوان_مقرر(اردو_متن(عنوان), خط_حجم=16, مقام_رکھو=اصل_متن('متن_۱۱۴_۱۰۵_۱۰۳_۱۰۴_۱۱۶'), حاشیہ_دو=12)
        محور.افقی_نام_مقرر(اردو_متن('تربیتی دور'), لیبل_فاصلہ=10)
        محور.عمودی_نام_مقرر(اردو_متن(لیبل), لیبل_فاصلہ=10)
        محور_سجاؤ(محور, فیصد)
        محور.عمودی_حد_مقرر(نیچے=0, اوپر=100 اگر فیصد ورنہ کچھ_نہیں)
        اگر لمبائی(ادوار) > 1:
            محور.محور_حد(ادوار.کمترین(), ادوار.زیادہترین())
            وقفہ = زیادہترین(1, ریاضی.چھت((ادوار.زیادہترین() - ادوار.کمترین()) / 8))
            نشانات = ترتیب(مجموعہ([صحیح_عدد(ادوار.کمترین()), صحیح_عدد(ادوار.زیادہترین())] + فہرست(حد(صحیح_عدد(ادوار.کمترین()), صحیح_عدد(ادوار.زیادہترین()) + 1, وقفہ))))
            محور.افقی_نشان_مقرر(نشانات)
        ورنہ:
            محور.افقی_نشان_مقرر(ادوار)
        محور.وضاحت(چارچوب=جھوٹ, خط_حجم=11, مقام_رکھو=اصل_متن('متن_۹۸_۱۰۱_۱۱۵_۱۱۶'))
    شکل.خاکہ_متن(0.5, 0.075, اردو_متن('تربیتی تصاویر: ' + وضع(اطلاع['تربیتی_تعداد'], ',') + '   |   توثیقی تصاویر: ' + وضع(اطلاع['توثیقی_تعداد'], ',')), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), رنگ=_سیاہ, خط_حجم=12)
    شکل.خاکہ_متن(0.5, 0.025, اردو_متن('آزمائشی تصاویر ان منحنیات میں شامل نہیں ہیں۔'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), رنگ=_سرمئی, خط_حجم=11)
    واپس محفوظ_کرو(شکل, منزل, 'تربیتی_خاکے')

فنکشن الجھاؤ_خاکہ(جدول, جماعتیں, اطلاع, منزل):
    شکل, محور = قلم.ذیلی_خاکے(خاکہ_حجم=(12.8, 11.2))
    شکل.محور_درستگی(بائیں=0.15, دائیں=0.88, نیچے=0.16, اوپر=0.83)
    شکل.مجموعی_عنوان(اردو_متن('آزمائشی پیشگوئیوں کا الجھاؤ جدول'), خط_حجم=22, عمودی_مقام=0.97)
    شکل.خاکہ_متن(0.5, 0.905, اردو_متن(وضع(اطلاع['آزمائشی_تعداد'], ',') + ' تصاویر   |   درستگی: ' + وضع(اطلاع['آزمائشی_درستگی'] * 100, اصل_متن('متن_۴۶_۵۰_۱۰۲')) + '٪'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), خط_حجم=13, رنگ=_سرمئی)
    رنگ = رنگی_نقشہ.اصل_۱۰۲_۱۱۴_۱۱۱_۱۰۹_۹۵_۱۰۸_۱۰۵_۱۱۵_۱۱۶(اصل_متن('متن_۱۱۷_۱۱۴_۱۰۰_۱۱۷_۹۵_۹۸_۱۰۸_۱۱۷_۱۰۱'), [اصل_متن('متن_۳۵_۷۰_۵۲_۷۰_۵۵_۷۰_۶۵'), اصل_متن('متن_۳۵_۶۵_۵۲_۶۷_۵۴_۶۸_۷۰'), اصل_متن('متن_۳۵_۵۰_۵۲_۵۳_۶۶_۵۶_۶۵')])
    نقش = محور.تصویر_دکھاؤ(جدول, رنگ_نقشہ=رنگ, کم_قدر=0)
    محور.افقی_نشان_مقرر(حد(لمبائی(جماعتیں)), [اردو_متن(نام) ہر نام میں جماعتیں], خط_حجم=12)
    محور.عمودی_نشان_مقرر(حد(لمبائی(جماعتیں)), [اردو_متن(نام) ہر نام میں جماعتیں], خط_حجم=12)
    محور.افقی_نام_مقرر(اردو_متن('پیشگوئی کردہ جماعت'), خط_حجم=14, لیبل_فاصلہ=16)
    محور.عمودی_نام_مقرر(اردو_متن('حقیقی جماعت'), خط_حجم=14, لیبل_فاصلہ=18)
    محور.افقی_نشان_مقرر(عددی_کتاب.عددی_حد(لمبائی(جماعتیں) + 1) - 0.5, چھوٹے_نشان=سچ)
    محور.عمودی_نشان_مقرر(عددی_کتاب.عددی_حد(لمبائی(جماعتیں) + 1) - 0.5, چھوٹے_نشان=سچ)
    محور.جالی(کونسا=اصل_متن('متن_۱۰۹_۱۰۵_۱۱۰_۱۱۱_۱۱۴'), رنگ=سفید_رنگ, خط_موٹائی=1.2)
    محور.محور_اعداد(کونسا=اصل_متن('متن_۱۰۹_۱۰۵_۱۱۰_۱۱۱_۱۱۴'), نیچے=جھوٹ, بائیں=جھوٹ)
    ہر حاشیہ میں محور.حاشیے.قدریں():
        حاشیہ.مرئی_کرو(جھوٹ)
    حد_رنگ = جدول.زیادہترین() * 0.57
    ہر صف میں حد(لمبائی(جماعتیں)):
        ہر ستون میں حد(لمبائی(جماعتیں)):
            تعداد = صحیح_عدد(جدول[صف, ستون])
            محور.خاکہ_متن(ستون, صف, اردو_عدد(تعداد), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), عمودی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), خط_حجم=11, رنگ=سفید_رنگ اگر تعداد > حد_رنگ ورنہ _سیاہ)
    پیمانہ = شکل.رنگی_پیمانہ(نقش, محور_شکل=محور, شرح_پیمانہ=0.041, حاشیہ_دو=0.04)
    پیمانہ.اصل_۱۱۵_۱۰۱_۱۱۶_۹۵_۱۰۸_۹۷_۹۸_۱۰۱_۱۰۸(اردو_متن('تصاویر کی تعداد'), خط_حجم=12, لیبل_فاصلہ=14)
    پیمانہ.محور_شکل.عمودی_محور.بڑے_نشان_جگہ(صحیح_نشانات(صحیح_نشان=سچ))
    پیمانہ.محور_شکل.عمودی_محور.بڑے_نشان_وضع(عدد_وضع_کار(اردو_عدد))
    شکل.خاکہ_متن(0.5, 0.055, اردو_متن('صف: حقیقی جماعت   |   ستون: پیشگوئی کردہ جماعت   |   ہر خانے میں تصاویر کی تعداد'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), خط_حجم=12, رنگ=_سرمئی)
    واپس محفوظ_کرو(شکل, منزل, 'الجھاؤ_جدول')

فنکشن جماعتی_خاکہ(جدول, جماعتیں, اطلاع, منزل):
    تعداد = جدول.جمع_کل(محور=1)
    درست = عددی_کتاب.قطری(جدول)
    شرح = عددی_کتاب.تقسیم_اعداد(درست * 100.0, تعداد, مخرج_قدر=عددی_کتاب.بھری_سرنی(لمبائی(جماعتیں), عددی_کتاب.اصل_۱۱۰_۹۷_۱۱۰), جہاں=تعداد > 0)
    شکل, محور = قلم.ذیلی_خاکے(خاکہ_حجم=(12, 8.8))
    شکل.محور_درستگی(بائیں=0.18, دائیں=0.87, نیچے=0.15, اوپر=0.8)
    شکل.مجموعی_عنوان(اردو_متن('ہر جماعت کی آزمائشی درستگی'), خط_حجم=22, عمودی_مقام=0.97)
    شکل.خاکہ_متن(0.5, 0.89, اردو_متن('مکمل آزمائشی مجموعہ: ' + وضع(اطلاع['آزمائشی_تعداد'], ',') + ' تصاویر'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), رنگ=_سرمئی, خط_حجم=13)
    مقامات = عددی_کتاب.عددی_حد(لمبائی(جماعتیں))
    محور.افقی_ستون(مقامات, عددی_کتاب.غیرعددی_بدلو(شرح), رنگ=_نیلا, بلندی=0.64)
    محور.عمودی_نشان_مقرر(مقامات, [اردو_متن(نام) ہر نام میں جماعتیں], خط_حجم=13)
    محور.عمودی_الٹ()
    محور.محور_حد(0, 100)
    محور.افقی_نشان_مقرر([0, 20, 40, 60, 80, 100])
    محور.افقی_محور.بڑے_نشان_وضع(عدد_وضع_کار(اردو_فیصد))
    محور.افقی_نام_مقرر(اردو_متن('اپنی حقیقی جماعت میں درست پیشگوئیوں کا تناسب (٪)'), خط_حجم=13, لیبل_فاصلہ=14)
    محور.جالی(محور=اصل_متن('متن_۱۲۰'), رنگ=اصل_متن('متن_۳۵_۶۹_۵۱_۶۹_۵۵_۶۹_۶۶'), خط_موٹائی=0.8)
    محور.نیچے_جالی(سچ)
    ہر نام میں (اصل_متن('متن_۱۱۶_۱۱۱_۱۱۲'), اصل_متن('متن_۱۱۴_۱۰۵_۱۰۳_۱۰۴_۱۱۶'), اصل_متن('متن_۱۰۸_۱۰۱_۱۰۲_۱۱۶')):
        محور.حاشیے[نام].مرئی_کرو(جھوٹ)
    محور.حاشیے[اصل_متن('متن_۹۸_۱۱۱_۱۱۶_۱۱۶_۱۱۱_۱۰۹')].رنگ_مقرر(اصل_متن('متن_۳۵_۶۵_۵۳_۶۵_۷۰_۶۶_۵۷'))
    محور.محور_اعداد(محور=اصل_متن('متن_۱۲۱'), نشان_لمبائی=0, حاشیہ_دو=10)
    ہر مقام, شرح_جماعت, صحیح, کل میں اکٹھا(مقامات, شرح, درست, تعداد):
        لیبل = وضع(شرح_جماعت, اصل_متن('متن_۴۶_۴۹_۱۰۲')) + '٪  (' + متن(صحیح) + '/' + متن(کل) + ')' اگر کل > 0 ورنہ 'کوئی تصویر نہیں'
        محور.خاکہ_متن(102, مقام, اردو_متن(لیبل), عمودی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), افقی_صفائی=اصل_متن('متن_۱۰۸_۱۰۱_۱۰۲_۱۱۶'), خط_حجم=11, رنگ=_سیاہ, تراش_اجازت=جھوٹ)
    شکل.خاکہ_متن(0.5, 0.035, اردو_متن('قوسین میں: درست تصاویر / اس جماعت کی کل تصاویر'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), خط_حجم=12, رنگ=_سرمئی)
    واپس محفوظ_کرو(شکل, منزل, 'جماعتی_درستگی')

فنکشن تصویری_خاکہ(پیشگوئیاں, جماعتیں, منزل):
    تصاویر = پیشگوئیاں.لو('تصاویر', [])
    اگر لمبائی(تصاویر) == 0:
        شکل, محور = قلم.ذیلی_خاکے(خاکہ_حجم=(9, 5))
        محور.محور(اصل_متن('متن_۱۱۱_۱۰۲_۱۰۲'))
        محور.خاکہ_متن(0.5, 0.55, اردو_متن('خام تصویری نمونے محفوظ نہیں ہیں'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), خط_حجم=21)
        محور.خاکہ_متن(0.5, 0.4, اردو_متن('حسابی پیشگوئیاں الگ فائل میں دستیاب ہیں۔'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), خط_حجم=14)
        واپس محفوظ_کرو(شکل, منزل, 'پیشگوئیاں')
    اشاریے = پیشگوئیاں.لو('نمونہ_اشاریے', فہرست(حد(لمبائی(تصاویر))))
    اگر لمبائی(اشاریے) != لمبائی(تصاویر):
        اٹھاؤ قدر_خطا(اصل_متن('متن_۱۱۵_۹۷_۱۰۹_۱۱۲_۱۰۸_۱۰۱_۹۵_۱۰۵_۱۱۰_۱۰۰_۱۰۵_۹۹_۱۰۱_۱۱۵_۳۲_۱۵۷۵_۱۶۰۸_۱۵۸۵_۳۲_۱۰۵_۱۰۹_۹۷_۱۰۳_۱۰۱_۱۱۵_۳۲_۱۷۰۵_۱۷۴۰_۳۲_۱۵۷۸_۱۵۹۳_۱۵۸۳_۱۵۷۵_۱۵۸۳_۳۲_۱۵۷۶_۱۵۸۵_۱۵۷۵_۱۵۷۶_۱۵۸۵_۳۲_۱۷۲۹_۱۶۰۸_۱۶۰۶_۱۷۴۰_۳۲_۱۶۷۰_۱۵۷۵_۱۷۲۹_۱۷۴۰_۱۷۴۶_۱۷۴۸'))
    کل = کمترین(لمبائی(تصاویر), 20)
    تیار = []
    ہر مقام میں حد(کل):
        اشاریہ = صحیح_عدد(اشاریے[مقام])
        اگر اشاریہ < 0 یا اشاریہ >= لمبائی(پیشگوئیاں['اصل']):
            اٹھاؤ قدر_خطا(اصل_متن('متن_۱۱۵_۹۷_۱۰۹_۱۱۲_۱۰۸_۱۰۱_۹۵_۱۰۵_۱۱۰_۱۰۰_۱۰۵_۹۹_۱۰۱_۱۱۵_۳۲_۱۶۰۵_۱۷۴۰_۱۷۲۲_۳۲_۱۵۷۸_۱۵۸۹_۱۶۰۸_۱۷۴۰_۱۵۸۵_۳۲_۱۷۰۵_۱۵۷۵_۳۲_۱۵۷۵_۱۵۸۸_۱۵۷۵_۱۵۸۵_۱۷۴۰_۱۷۲۹_۳۲_۱۵۸۱_۱۵۸۳_۳۲_۱۵۸۷_۱۷۴۶_۳۲_۱۵۷۶_۱۵۷۵_۱۷۲۹_۱۵۸۵_۳۲_۱۷۲۹_۱۷۴۶_۱۷۴۸'))
        تصویر = عددی_کتاب.بطور_سرنی(تصاویر[مقام])
        اگر تصویر.ابعاد != 3:
            اٹھاؤ قدر_خطا(اصل_متن('متن_۱۵۷۸_۱۵۸۹_۱۶۰۸_۱۷۴۰_۱۵۸۵_۳۲_۱۵۷۸_۱۷۴۰_۱۶۰۶_۳۲_۱۵۸۰_۱۷۲۹_۱۵۷۸_۱۷۴۰_۳۲_۸۲_۷۱_۶۶_۳۲_۱۷۲۹_۱۶۰۸_۱۶۰۶_۱۷۴۰_۳۲_۱۶۷۰_۱۵۷۵_۱۷۲۹_۱۷۴۰_۱۷۴۶_۱۷۴۸'))
        اگر تصویر.شکل[0] == 3 اور تصویر.شکل[-1] != 3:
            تصویر = تصویر.ترتیب_بدلو(1, 2, 0)
        اگر تصویر.شکل[-1] != 3 یا تصویر.قسم_اعداد != عددی_کتاب.غیر_منفی۸:
            اٹھاؤ قدر_خطا(اصل_متن('متن_۱۰۵_۱۰۹_۹۷_۱۰۳_۱۰۱_۱۱۵_۳۲_۱۶۰۵_۱۷۴۰_۱۷۲۲_۳۲_۱۵۸۲_۱۵۷۵_۱۶۰۵_۳۲_۱۱۷_۱۰۵_۱۱۰_۱۱۶_۵۶_۳۲_۸۲_۷۱_۶۶_۳۲_۱۵۷۸_۱۵۸۹_۱۵۷۵_۱۶۰۸_۱۷۴۰_۱۵۸۵_۳۲_۱۵۸۳_۱۵۸۵_۱۷۰۵_۱۵۷۵_۱۵۸۵_۳۲_۱۷۲۹_۱۷۴۰_۱۷۲۲_۱۵۶۳_۳۲_۱۶۰۶_۱۵۷۵_۱۵۸۵_۱۶۰۵_۱۶۰۴_۱۵۷۵_۱۵۷۴_۱۵۸۶_۳۲_۱۵۸۸_۱۵۸۳_۱۷۲۹_۳۲_۱۶۵۷_۱۷۴۰_۱۶۰۶_۱۵۸۷_۱۵۸۵_۳۲_۱۶۰۶_۱۷۲۹_۱۷۴۰_۱۷۲۲_۱۷۴۸'))
        تیار.آخر_لگاؤ(تصویر)
    ستون = 5 اگر کل > 12 ورنہ 4
    صفیں = ریاضی.چھت(کل / ستون)
    شکل, محاور = قلم.ذیلی_خاکے(صفیں, ستون, خاکہ_حجم=(3.25 * ستون, 3.7 * صفیں + 1.25), دباؤ=جھوٹ)
    شکل.محور_درستگی(بائیں=0.035, دائیں=0.965, نیچے=0.04, اوپر=0.84, عمودی_خلاء=0.58, افقی_خلاء=0.25)
    شکل.مجموعی_عنوان(اردو_متن('آزمائشی تصاویر اور ریسنیٹ کی پیشگوئیاں'), خط_حجم=22, عمودی_مقام=0.99)
    شکل.خاکہ_متن(0.5, 0.92, اردو_متن('ہر تصویر کے اوپر حقیقی جماعت اور پیشگوئی درج ہے۔'), افقی_صفائی=اصل_متن('متن_۹۹_۱۰۱_۱۱۰_۱۱۶_۱۰۱_۱۱۴'), رنگ=_سرمئی, خط_حجم=12)
    ہر مقام, محور میں گنو(محاور.خانوں_میں):
        محور.محور(اصل_متن('متن_۱۱۱_۱۰۲_۱۰۲'))
        اگر مقام >= کل:
            جاری
        اشاریہ = صحیح_عدد(اشاریے[مقام])
        تصویر = تیار[مقام]
        حقیقی = صحیح_عدد(پیشگوئیاں['اصل'][اشاریہ])
        اندازہ = صحیح_عدد(پیشگوئیاں['متوقع'][اشاریہ])
        محور.تصویر_دکھاؤ(تصویر)
        حالت = 'درست' اگر حقیقی == اندازہ ورنہ 'غلط'
        عنوان = 'حقیقی: ' + متن(جماعتیں[حقیقی]) + اصل_متن('متن_۱۰_۱۶۶۲_۱۷۴۰_۱۵۸۸_۱۷۱۱_۱۶۰۸_۱۵۷۴_۱۷۴۰_۵۸_۳۲') + متن(جماعتیں[اندازہ]) + ' — ' + متن(حالت)
        محور.عنوان_مقرر(اصل_متن('متن_۱۰').جوڑو((اردو_متن(سطر) ہر سطر میں عنوان.سطریں_توڑو())), رنگ=_نیلا اگر حقیقی == اندازہ ورنہ _سنہری, خط_حجم=12, حاشیہ_دو=9)
    واپس محفوظ_کرو(شکل, منزل, 'پیشگوئیاں')

فنکشن خاکے_بناؤ(تاریخ, اطلاع, پیشگوئیاں, مخرج):
    """حقیقی نتائج کے اردو خاکے؛ درستگی صفر تا ایک اور شمار اصل تصاویر کے ہیں۔"""
    اگر نہیں تاریخ:
        اٹھاؤ قدر_خطا('تربیتی تاریخ خالی نہیں ہو سکتی۔')
    جماعتیں = اطلاع['جماعتیں']
    اگر نہیں جماعتیں یا لمبائی(مجموعہ(جماعتیں)) != لمبائی(جماعتیں):
        اٹھاؤ قدر_خطا('جماعتوں کے اردو نام منفرد اور غیر خالی ہوں۔')
    حقیقی = عددی_کتاب.بطور_سرنی(پیشگوئیاں['اصل'], قسم_اعداد=عددی_کتاب.صحیح۶۴)
    اندازے = عددی_کتاب.بطور_سرنی(پیشگوئیاں['متوقع'], قسم_اعداد=عددی_کتاب.صحیح۶۴)
    اگر حقیقی.ابعاد != 1 یا حقیقی.شکل != اندازے.شکل یا حقیقی.حجم != اطلاع['آزمائشی_تعداد']:
        اٹھاؤ قدر_خطا(اصل_متن('متن_۱۵۷۰_۱۵۸۶_۱۶۰۵_۱۵۷۵_۱۵۷۴_۱۵۸۸_۱۷۴۰_۳۲_۱۰۸_۹۷_۹۸_۱۰۱_۱۰۸_۱۱۵_۱۵۴۸_۳۲_۱۱۲_۱۱۴_۱۰۱_۱۰۰_۱۰۵_۹۹_۱۱۶_۱۰۵_۱۱۱_۱۱۰_۱۱۵_۳۲_۱۵۷۵_۱۶۰۸_۱۵۸۵_۳۲_۱۱۶_۱۰۱_۱۱۵_۱۱۶_۹۵_۹۹_۱۱۱_۱۱۷_۱۱۰_۱۱۶_۳۲_۱۷۰۵_۱۷۴۰_۳۲_۱۵۷۸_۱۵۹۳_۱۵۸۳_۱۵۷۵_۱۵۸۳_۳۲_۱۶۰۵_۱۵۸۲_۱۵۷۸_۱۶۰۴_۱۶۰۱_۳۲_۱۷۲۹_۱۷۴۶_۱۷۴۸'))
    اگر حقیقی.حجم == 0:
        اٹھاؤ قدر_خطا('آزمائشی مجموعہ خالی ہے۔')
    اگر عددی_کتاب.کوئی(حقیقی < 0) یا عددی_کتاب.کوئی(حقیقی >= لمبائی(جماعتیں)) یا عددی_کتاب.کوئی(اندازے < 0) یا عددی_کتاب.کوئی(اندازے >= لمبائی(جماعتیں)):
        اٹھاؤ قدر_خطا('جماعت کا اشاریہ حد سے باہر ہے۔')
    اگر نہیں ریاضی.قریب_ہے(اعشاری_ٹینسر(عددی_کتاب.اوسط(حقیقی == اندازے)), اطلاع['آزمائشی_درستگی'], مطلق_رواداری=0.0000001):
        اٹھاؤ قدر_خطا('پیشگوئیوں کی درستگی رپورٹ سے مختلف ہے۔')
    ادوار = []
    ہر سطر میں تاریخ:
        ادوار.آخر_لگاؤ(سطر['دور'])
        ہر چابی میں ('تربیتی_نقصان', 'توثیقی_نقصان', 'تربیتی_درستگی', 'توثیقی_درستگی'):
            قدر = سطر[چابی]
            اگر نہیں ریاضی.محدود_ہے(قدر) یا قدر < 0 یا ('درستگی' میں چابی اور قدر > 1):
                اٹھاؤ قدر_خطا('تربیتی قدر درست نہیں: ' + متن(چابی))
    اگر ادوار != ترتیب(مجموعہ(ادوار)):
        اٹھاؤ قدر_خطا('تربیتی ادوار منفرد اور صعودی ترتیب میں ہوں۔')
    جدول = عددی_کتاب.صفر((لمبائی(جماعتیں), لمبائی(جماعتیں)), قسم_اعداد=عددی_کتاب.صحیح۶۴)
    عددی_کتاب.اصل_۹۷_۱۰۰_۱۰۰.اصل_۹۷_۱۱۶(جدول, (حقیقی, اندازے), 1)
    منزل = فائل_راستہ(مخرج) / 'خاکے'
    منزل.فولڈر_بناؤ(والدین=سچ, موجود_اجازت=سچ)
    وضع = {اصل_متن('متن_۱۰۲_۱۱۱_۱۱۰_۱۱۶_۴۶_۱۰۲_۹۷_۱۰۹_۱۰۵_۱۰۸_۱۲۱'): خط_چنو(اطلاع), اصل_متن('متن_۱۰۲_۱۱۱_۱۱۰_۱۱۶_۴۶_۱۱۵_۱۰۵_۱۲۲_۱۰۱'): 12, اصل_متن('متن_۱۱۶_۱۰۱_۱۲۰_۱۱۶_۴۶_۹۹_۱۱۱_۱۰۸_۱۱۱_۱۱۴'): _سیاہ, اصل_متن('متن_۹۷_۱۲۰_۱۰۱_۱۱۵_۴۶_۱۰۸_۹۷_۹۸_۱۰۱_۱۰۸_۹۹_۱۱۱_۱۰۸_۱۱۱_۱۱۴'): _سیاہ, اصل_متن('متن_۹۷_۱۲۰_۱۰۱_۱۱۵_۴۶_۱۱۶_۱۰۵_۱۱۶_۱۰۸_۱۰۱_۹۹_۱۱۱_۱۰۸_۱۱۱_۱۱۴'): _سیاہ, اصل_متن('متن_۱۰۲_۱۰۵_۱۰۳_۱۱۷_۱۱۴_۱۰۱_۴۶_۱۰۲_۹۷_۹۹_۱۰۱_۹۹_۱۱۱_۱۰۸_۱۱۱_۱۱۴'): سفید_رنگ, اصل_متن('متن_۹۷_۱۲۰_۱۰۱_۱۱۵_۴۶_۱۰۲_۹۷_۹۹_۱۰۱_۹۹_۱۱۱_۱۰۸_۱۱۱_۱۱۴'): سفید_رنگ, اصل_متن('متن_۱۱۵_۱۱۸_۱۰۳_۴۶_۱۰۲_۱۱۱_۱۱۰_۱۱۶_۱۱۶_۱۲۱_۱۱۲_۱۰۱'): اصل_متن('متن_۱۱۲_۹۷_۱۱۶_۱۰۴'), اصل_متن('متن_۹۷_۱۲۰_۱۰۱_۱۱۵_۴۶_۱۱۷_۱۱۰_۱۰۵_۹۹_۱۱۱_۱۰۰_۱۰۱_۹۵_۱۰۹_۱۰۵_۱۱۰_۱۱۷_۱۱۵'): جھوٹ}
    اگر اصل_متن('متن_۱۱۶_۱۰۱_۱۲۰_۱۱۶_۴۶_۱۰۸_۹۷_۱۱۰_۱۰۳_۱۱۷_۹۷_۱۰۳_۱۰۱') میں قلم.ترتیبات:
        وضع[اصل_متن('متن_۱۱۶_۱۰۱_۱۲۰_۱۱۶_۴۶_۱۰۸_۹۷_۱۱۰_۱۰۳_۱۱۷_۹۷_۱۰۳_۱۰۱')] = اصل_متن('متن_۱۱۷_۱۱۴')
    ساتھ قلم.سیاق_ترتیب(وضع):
        راستے = تربیتی_خاکہ(تاریخ, اطلاع, منزل)
        راستے.بڑھاؤ(الجھاؤ_خاکہ(جدول, جماعتیں, اطلاع, منزل))
        راستے.بڑھاؤ(جماعتی_خاکہ(جدول, جماعتیں, اطلاع, منزل))
        راستے.بڑھاؤ(تصویری_خاکہ(پیشگوئیاں, جماعتیں, منزل))
    واپس راستے
