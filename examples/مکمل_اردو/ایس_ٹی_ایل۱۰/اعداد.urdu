# اردوپائی: مکمل
"""سرکاری خام تصاویر سے الگ تربیتی، توثیقی اور آزمائشی مجموعے تیار کریں۔"""

درآمد نمپی
درآمد ٹارچ
درآمد بصارت
درآمد خلاصہ_حساب
سے راستے درآمد راستہ
سے ٹارچ.سہولتیں.مواد درآمد مواد_مجموعہ
سے بصارت.تبدیلیاں درآمد افعال بطور بصری


جماعتوں_کے_نام = ["ہوائی جہاز", "پرندہ", "گاڑی", "بلی", "ہرن", "کتا", "گھوڑا", "بندر", "بحری جہاز", "ٹرک"]
اصل_فولڈر = اصل_متن("متن_۱۱۵_۱۱۶_۱۰۸_۴۹_۴۸_۹۵_۹۸_۱۰۵_۱۱۰_۹۷_۱۱۴_۱۲۱")
تربیتی_عکس_فائل = اصل_متن("متن_۱۱۶_۱۱۴_۹۷_۱۰۵_۱۱۰_۹۵_۸۸_۴۶_۹۸_۱۰۵_۱۱۰")
تربیتی_نشان_فائل = اصل_متن("متن_۱۱۶_۱۱۴_۹۷_۱۰۵_۱۱۰_۹۵_۱۲۱_۴۶_۹۸_۱۰۵_۱۱۰")
آزمائشی_عکس_فائل = اصل_متن("متن_۱۱۶_۱۰۱_۱۱۵_۱۱۶_۹۵_۸۸_۴۶_۹۸_۱۰۵_۱۱۰")
آزمائشی_نشان_فائل = اصل_متن("متن_۱۱۶_۱۰۱_۱۱۵_۱۱۶_۹۵_۱۲۱_۴۶_۹۸_۱۰۵_۱۱۰")
فائل_جانچ = {
    تربیتی_عکس_فائل: اصل_متن("متن_۵۷_۴۹_۵۶_۹۹_۵۰_۵۶_۵۵_۴۹_۹۸_۵۱_۴۸_۹۷_۵۶_۵۳_۱۰۲_۹۷_۴۸_۵۰_۵۱_۱۰۱_۴۸_۹۹_۵۲_۵۲_۱۰۱_۴۸_۹۸_۱۰۱_۱۰۱_۵۶_۵۵_۱۰۲"),
    تربیتی_نشان_فائل: اصل_متن("متن_۵۳_۹۷_۵۱_۵۲_۴۸_۵۶_۵۷_۱۰۰_۵۲_۵۶_۴۸_۵۰_۹۹_۵۴_۵۵_۵۲_۵۶_۵۶_۴۹_۹۸_۹۷_۱۰۰_۹۸_۹۸_۵۶_۴۸_۵۱_۴۸_۵۵_۵۵_۵۲_۴۹"),
    آزمائشی_عکس_فائل: اصل_متن("متن_۵۵_۱۰۲_۵۰_۵۴_۵۱_۹۸_۹۷_۵۷_۱۰۲_۵۷_۱۰۱_۴۸_۹۸_۴۸_۵۴_۹۸_۵۷_۵۱_۵۰_۴۹_۵۱_۵۳_۵۲_۵۵_۱۰۲_۵۵_۵۰_۴۹_۹۷_۹۹_۵۶_۵۰"),
    آزمائشی_نشان_فائل: اصل_متن("متن_۵۱_۵۴_۱۰۲_۵۷_۵۵_۵۷_۵۲_۱۰۲_۹۷_۵۲_۹۸_۱۰۱_۹۸_۵۶_۹۷_۵۰_۹۹_۵۵_۵۰_۵۴_۵۰_۵۶_۱۰۰_۱۰۱_۴۹_۵۲_۱۰۲_۹۷_۵۴_۵۱_۵۶_۱۰۱"),
}


فنکشن فائل_درست_ہے(فائل_راستہ, متوقع):
    اگر نہیں فائل_راستہ.فائل_ہے():
        واپس جھوٹ
    ساتھ کھولو(فائل_راستہ, بائٹ_پڑھنے_حالت) بطور بہاؤ:
        واپس خلاصہ_حساب.فائل_خلاصہ(بہاؤ, اصل_متن("متن_۱۰۹_۱۰۰_۵۳")).خلاصہ_متن() == متوقع


فنکشن طبقاتی_تقسیم(نشانات, تخم=42, توثیق_فی_جماعت=100):
    """ہر جماعت سے یکساں الگ توثیقی حصہ؛ عالمی اتفاقی حالت تبدیل نہیں ہوتی۔"""
    نشانات = ٹارچ.بطور_ٹینسر(نشانات, قسم_اعداد=ٹارچ.صحیح۶۴)
    اگر نشانات.ابعاد != 1 یا لمبائی(نشانات) == 0:
        اٹھاؤ قدر_خطا("نشانات غیر خالی یک جہتی فہرست ہوں۔")
    اگر نہیں مثال_ہے(توثیق_فی_جماعت, صحیح_عدد) یا مثال_ہے(توثیق_فی_جماعت, بولی) یا توثیق_فی_جماعت < 1:
        اٹھاؤ قدر_خطا("ہر جماعت کا توثیقی حصہ مثبت صحیح عدد ہونا چاہیے۔")
    تخمی_اوزار = ٹارچ.جنریٹر().بیج_مقرر(تخم)
    تربیتی_حصہ_فہرست, توثیقی_حصہ_فہرست = [], []
    ہر جماعت_نمبر میں ٹارچ.منفرد(نشانات, ترتیب=سچ).فہرست_میں():
        مقامات = ٹارچ.جہاں(نشانات == جماعت_نمبر)[0]
        اگر لمبائی(مقامات) <= توثیق_فی_جماعت:
            اٹھاؤ قدر_خطا("ہر جماعت میں توثیق سے زیادہ تصاویر ضروری ہیں۔")
        مقامات = مقامات[ٹارچ.اتفاقی_ترتیب(لمبائی(مقامات), بیج_جنریٹر=تخمی_اوزار)]
        توثیقی_حصہ_فہرست.بڑھاؤ(مقامات[:توثیق_فی_جماعت].فہرست_میں())
        تربیتی_حصہ_فہرست.بڑھاؤ(مقامات[توثیق_فی_جماعت:].فہرست_میں())
    تربیتی_اشاریے = ٹارچ.ٹینسر(تربیتی_حصہ_فہرست, قسم_اعداد=ٹارچ.صحیح۶۴)
    توثیقی_اشاریے = ٹارچ.ٹینسر(توثیقی_حصہ_فہرست, قسم_اعداد=ٹارچ.صحیح۶۴)
    واپس (
        تربیتی_اشاریے[ٹارچ.اتفاقی_ترتیب(لمبائی(تربیتی_اشاریے), بیج_جنریٹر=تخمی_اوزار)],
        توثیقی_اشاریے[ٹارچ.اتفاقی_ترتیب(لمبائی(توثیقی_اشاریے), بیج_جنریٹر=تخمی_اوزار)])


فنکشن تربیتی_پیمانے(عکس):
    """صرف فراہم کردہ تربیتی تصاویر سے فی رنگ آبادی کے پیمانے۔"""
    اگر عکس.ابعاد != 4 یا عکس.شکل[1] != 3 یا لمبائی(عکس) == 0:
        اٹھاؤ قدر_خطا("تصاویر کی شکل نمونے، تین رنگ، بلندی اور چوڑائی ہو۔")
    اعداد = عکس.منتقل(ٹارچ.اعشاری۶۴) / 255.0
    مرکزی_اوسط = اعداد.اوسط(بعد=(0, 2, 3))
    مرکزی_انحراف = اعداد.انحراف(بعد=(0, 2, 3), تصحیح=0).ٹینسر_محدود(کمترین=0.00000001)
    واپس مرکزی_اوسط.فہرست_میں(), مرکزی_انحراف.فہرست_میں()


کلاس تصویری_مجموعہ(مواد_مجموعہ):
    """تربیتی تراش اور افقی پلٹ؛ توثیق و آزمائش میں کوئی اتفاقی تبدیلی نہیں۔"""

    فنکشن آغاز(خود, عکس, نشانات, مرکزی_اوسط, مرکزی_انحراف, سکھانا=جھوٹ, تخم=42):
        اگر عکس.قسم_اعداد != ٹارچ.غیر_منفی۸ یا عکس.ابعاد != 4 یا عکس.شکل[1] != 3:
            اٹھاؤ قدر_خطا("تصاویر صحیح غیر منفی آٹھ بٹ اور چار جہتی ہوں۔")
        اگر لمبائی(عکس) != لمبائی(نشانات):
            اٹھاؤ قدر_خطا("تصاویر اور نشانات کی تعداد یکساں ہو۔")
        خود.عکس = عکس.مسلسل()
        خود.نشانات = ٹارچ.بطور_ٹینسر(نشانات, قسم_اعداد=ٹارچ.صحیح۶۴)
        اگر خود.نشانات.ابعاد != 1:
            اٹھاؤ قدر_خطا("ہر تصویر کا ایک نشان ضروری ہے۔")
        خود.مرکزی_اوسط = ٹارچ.ٹینسر(مرکزی_اوسط, قسم_اعداد=ٹارچ.اعشاری۳۲).منظر(3, 1, 1)
        خود.مرکزی_انحراف = ٹارچ.ٹینسر(مرکزی_انحراف, قسم_اعداد=ٹارچ.اعشاری۳۲).منظر(3, 1, 1)
        اگر نہیں ٹارچ.محدود_ہے(خود.مرکزی_اوسط).سب() یا نہیں ٹارچ.محدود_ہے(خود.مرکزی_انحراف).سب() یا (خود.مرکزی_انحراف <= 0).کوئی():
            اٹھاؤ قدر_خطا("اوسط محدود اور معیاری انحراف محدود مثبت ہو۔")
        خود.سکھانا = سکھانا
        خود.تخمی_اوزار = ٹارچ.جنریٹر().بیج_مقرر(تخم)
        خود.جماعتیں = جماعتوں_کے_نام.نقل_سرنی()

    فنکشن شے_لمبائی(خود):
        واپس لمبائی(خود.نشانات)

    فنکشن جزو_لو(خود, مقام):
        عکس = خود.عکس[مقام]
        اگر خود.سکھانا:
            بلندی, چوڑائی = عکس.شکل[-2:]
            کنارہ = زیادہترین(1, بلندی // 12)
            عکس = بصری.حاشیہ_دو(عکس, کنارہ, حاشیہ_اسلوب=عکس_حاشیہ)
            بالا, بائیں = ٹارچ.اتفاقی_صحیح(0, 2 * کنارہ + 1, (2,), بیج_جنریٹر=خود.تخمی_اوزار).فہرست_میں()
            عکس = عکس[:, بالا:بالا + بلندی, بائیں:بائیں + چوڑائی]
            اگر ٹارچ.اتفاقی_یکساں((), بیج_جنریٹر=خود.تخمی_اوزار).عدد_لو() < 0.5:
                عکس = عکس.پلٹو(-1)
        عکس = (عکس.منتقل(ٹارچ.اعشاری۳۲) / 255.0 - خود.مرکزی_اوسط) / خود.مرکزی_انحراف
        واپس عکس, خود.نشانات[مقام]


فنکشن خام_پڑھو(جڑ, مرحلہ):
    """سرکاری فائل میں آخری دو محورها چوڑائی پھر بلندی ہیں۔"""
    جڑ = راستہ(جڑ) / اصل_فولڈر
    اگر مرحلہ == "تربیتی":
        عکس_فائل, نشان_فائل = تربیتی_عکس_فائل, تربیتی_نشان_فائل
    ورنہ_اگر مرحلہ == "آزمائشی":
        عکس_فائل, نشان_فائل = آزمائشی_عکس_فائل, آزمائشی_نشان_فائل
    ورنہ:
        اٹھاؤ قدر_خطا("حصہ تربیتی یا آزمائشی منتخب کریں۔")
    نشانات = نمپی.فائل_سے(جڑ / نشان_فائل, قسم_اعداد=نمپی.غیر_منفی۸).قسم_بدلو(نمپی.صحیح۶۴) - 1
    عکس = نمپی.فائل_سے(جڑ / عکس_فائل, قسم_اعداد=نمپی.غیر_منفی۸).نئی_شکل(-1, 3, 96, 96).ترتیب_بدلو(0, 1, 3, 2)
    اگر لمبائی(عکس) != لمبائی(نشانات) یا (نشانات < 0).کوئی() یا (نشانات >= 10).کوئی():
        اٹھاؤ قدر_خطا("اصل تصاویر اور درست نشانات کی تعداد یکساں ہونی چاہیے۔")
    واپس ٹارچ.نمپی_سے(نمپی.متصل_سرنی(عکس)), ٹارچ.نمپی_سے(نشانات)


فنکشن جسامت_بدلو(عکس, جسامت):
    اگر عکس.شکل[-2:] == (جسامت, جسامت):
        واپس عکس.مسلسل()
    واپس ٹارچ.ٹینسر_یکجا([
        بصری.حجم_بدلو(ٹکڑا, [جسامت, جسامت], کنارے_ہموار=سچ)
        ہر ٹکڑا میں عکس.تقسیم(256)], بعد=0).مسلسل()


فنکشن اعداد_تیار_کرو(جڑ, جسامت=96, تخم=42, حصول=جھوٹ):
    """تربیت چار ہزار، توثیق ایک ہزار، آزمائش آٹھ ہزار؛ صرف تربیتی پیمانے۔"""
    اگر نہیں مثال_ہے(جسامت, صحیح_عدد) یا مثال_ہے(جسامت, بولی) یا جسامت < 16 یا جسامت > 96:
        اٹھاؤ قدر_خطا("تصویر کی جسامت سولہ سے چھیانوے کے درمیان صحیح عدد ہو۔")
    جڑ = راستہ(جڑ).مکمل_راستہ()
    اگر حصول اور نہیں سب(فائل_درست_ہے(جڑ / اصل_فولڈر / نام_فائل, متوقع) ہر نام_فائل, متوقع میں فائل_جانچ.جوڑے()):
        # یہ بڑی منتقلی صرف صارف کے واضح انتخاب پر شروع ہوتی ہے۔
        بصارت.ذخائر.ایس_ٹی_ایل۱۰(جڑ, حصول=سچ)
    ہر نام_فائل, متوقع میں فائل_جانچ.جوڑے():
        اگر نہیں فائل_درست_ہے(جڑ / اصل_فولڈر / نام_فائل, متوقع):
            اٹھاؤ عملی_خطا("سرکاری فائل موجود نہیں یا اس کی شناخت غلط ہے: " + نام_فائل)
    تربیتی_عکس, تربیتی_نشانات = خام_پڑھو(جڑ, "تربیتی")
    آزمائشی_عکس, آزمائشی_نشانات = خام_پڑھو(جڑ, "آزمائشی")
    تربیتی_عکس = جسامت_بدلو(تربیتی_عکس, جسامت)
    آزمائشی_عکس = جسامت_بدلو(آزمائشی_عکس, جسامت)
    اگر تربیتی_عکس.شکل != (5000, 3, جسامت, جسامت) یا آزمائشی_عکس.شکل != (8000, 3, جسامت, جسامت):
        اٹھاؤ عملی_خطا("سرکاری اعداد کی تصویر تعداد یا جسامت مختلف ہے۔")
    اگر نہیں ٹارچ.برابر(ٹارچ.شمار_اعداد(تربیتی_نشانات, کم_لمبائی=10), ٹارچ.بھری_سرنی((10,), 500)):
        اٹھاؤ عملی_خطا("ہر تربیتی جماعت میں پانچ سو تصاویر ضروری ہیں۔")
    اگر نہیں ٹارچ.برابر(ٹارچ.شمار_اعداد(آزمائشی_نشانات, کم_لمبائی=10), ٹارچ.بھری_سرنی((10,), 800)):
        اٹھاؤ عملی_خطا("ہر آزمائشی جماعت میں آٹھ سو تصاویر ضروری ہیں۔")
    تربیتی_اشاریے, توثیقی_اشاریے = طبقاتی_تقسیم(تربیتی_نشانات, تخم=تخم)
    مرکزی_اوسط, مرکزی_انحراف = تربیتی_پیمانے(تربیتی_عکس[تربیتی_اشاریے])
    واپس {
        "تربیتی": تصویری_مجموعہ(تربیتی_عکس[تربیتی_اشاریے], تربیتی_نشانات[تربیتی_اشاریے], مرکزی_اوسط, مرکزی_انحراف, سکھانا=سچ, تخم=تخم),
        "توثیقی": تصویری_مجموعہ(تربیتی_عکس[توثیقی_اشاریے], تربیتی_نشانات[توثیقی_اشاریے], مرکزی_اوسط, مرکزی_انحراف),
        "آزمائشی": تصویری_مجموعہ(آزمائشی_عکس, آزمائشی_نشانات, مرکزی_اوسط, مرکزی_انحراف),
        "تربیتی_اشاریے": تربیتی_اشاریے.فہرست_میں(),
        "توثیقی_اشاریے": توثیقی_اشاریے.فہرست_میں(),
        "اوسط": مرکزی_اوسط,
        "انحراف": مرکزی_انحراف,
        "جماعتیں": جماعتوں_کے_نام.نقل_سرنی(),
        "جسامت": جسامت,
        "ماخذ": {
            "مجموعہ": "ایس ٹی ایل دس", "اصل_تربیتی": 5000, "حقیقی_تربیتی": 4000,
            "توثیقی": 1000, "آزمائشی": 8000, "اصل_جسامت": 96,
            "چار_نشان_زدہ_فائلیں_تصدیق_شدہ": سچ,
            "اصل_فائل_شناختیں": فائل_جانچ.نقل_سرنی(),
            "پیمانے_کا_ماخذ": "صرف چار ہزار تربیتی تصاویر",
            "غیر_نشان_زدہ_استعمال": جھوٹ, "معیاری_دس_فولڈ": جھوٹ,
            "اضافہ": "تربیت میں تخمی عکسی حاشیہ، اتفاقی تراش اور افقی پلٹ",
            "حجمی_تبدیلی": "دو خطی ہموار آٹھ بٹ ٹینسر"},
    }

