# اردوپائی: مکمل
"""محفوظ تاریخ اور پیشگوئیوں سے نتائج کا آزاد حساب، اردو جدول اور رپورٹ۔"""
درآمد ریاضی
درآمد جیسن
درآمد جدولی_متن
درآمد خلاصہ_حساب
درآمد دلائل
سے راستے درآمد راستہ بطور فائل_راستہ
سے اردوپائی.احکام درآمد اردو_دلائل_تجزیہ_کار


فنکشن ثبوت_چاہیے(شرط, پیغام):
    اگر نہیں شرط:
        اٹھاؤ قدر_خطا(پیغام)


فنکشن اردو_عدد(قدر):
    واپس متن(قدر).ترجمہ_حروف(متن.ترجمہ_جدول("0123456789%", "۰۱۲۳۴۵۶۷۸۹٪"))


فنکشن محدود_عدد(قدر, زیادہ=کچھ_نہیں):
    واپس قسم(قدر) میں (صحیح_عدد, اعشاری) اور ریاضی.محدود_ہے(قدر) اور قدر >= 0 اور (زیادہ ہے کچھ_نہیں یا قدر <= زیادہ)


فنکشن پڑھو(راستہ):
    واپس جیسن.جیسن_پڑھو(فائل_راستہ(راستہ).متن_پڑھو(رمزبندی=متن_رمزبندی))


فنکشن لکھو(راستہ, قدر):
    فائل_راستہ(راستہ).متن_لکھو(جیسن.جیسن_متن(قدر, انگریزی_رمز_لازم=جھوٹ, آگے_فاصلہ=2), رمزبندی=متن_رمزبندی)


فنکشن فائل_ہیش(راستہ):
    واپس خلاصہ_حساب.شا۲۵۶(فائل_راستہ(راستہ).بائٹ_پڑھو()).خلاصہ_متن()


فنکشن حساب_جانچو(تاریخ, خلاصہ, پیشگوئیاں):
    ثبوت_چاہیے(قسم(تاریخ) ہے فہرست اور بولی(تاریخ), "تربیتی تاریخ غیر خالی فہرست ہو۔")
    ادوار = [سطر["دور"] ہر سطر میں تاریخ]
    ثبوت_چاہیے(سب(قسم(دور) ہے صحیح_عدد ہر دور میں ادوار) اور ادوار == فہرست(حد(1, لمبائی(تاریخ) + 1)), "تربیتی دور ایک سے مسلسل اور منفرد ہوں۔")
    ثبوت_چاہیے(خلاصہ["دور"] == لمبائی(تاریخ), "خلاصے اور تاریخ میں دور کی تعداد مختلف ہے۔")
    ہر سطر میں تاریخ:
        ہر چابی میں ("تربیتی_نقصان", "توثیقی_نقصان", "شرح", "ثانیے"):
            ثبوت_چاہیے(محدود_عدد(سطر[چابی]), "تربیتی تاریخ کا عدد محدود اور غیر منفی ہو۔")
        ہر چابی میں ("تربیتی_درستگی", "توثیقی_درستگی"):
            ثبوت_چاہیے(محدود_عدد(سطر[چابی], 1), "تاریخ کی درستگی صفر تا ایک ہو۔")
    بہترین_قدر = زیادہترین(سطر["توثیقی_درستگی"] ہر سطر میں تاریخ)
    بہترین_دور = اگلا(سطر["دور"] ہر سطر میں تاریخ اگر سطر["توثیقی_درستگی"] == بہترین_قدر)
    ثبوت_چاہیے(خلاصہ["بہترین_دور"] == بہترین_دور اور ریاضی.قریب_ہے(خلاصہ["بہترین_توثیقی_درستگی"], بہترین_قدر, مطلق_رواداری=0.000000000001), "منتخب دور توثیق کی بلند ترین درستگی کا پہلا دور ہو۔")
    جماعتیں = خلاصہ["جماعتیں"]
    ثبوت_چاہیے(قسم(جماعتیں) ہے فہرست اور بولی(جماعتیں) اور لمبائی(مجموعہ(جماعتیں)) == لمبائی(جماعتیں), "جماعتوں کے نام منفرد اور غیر خالی ہوں۔")
    ہر چابی میں ("تربیتی_تعداد", "توثیقی_تعداد", "آزمائشی_تعداد"):
        ثبوت_چاہیے(قسم(خلاصہ[چابی]) ہے صحیح_عدد اور خلاصہ[چابی] > 0, "تصاویر کی تعداد مثبت صحیح عدد ہو۔")
    اصل = پیشگوئیاں["اصل"]
    متوقع = پیشگوئیاں["متوقع"]
    اعتماد = پیشگوئیاں["اعتماد"]
    کل = خلاصہ["آزمائشی_تعداد"]
    ثبوت_چاہیے(لمبائی(اصل) == لمبائی(متوقع) == لمبائی(اعتماد) == کل, "نشان، پیشگوئیاں، اعتماد اور خلاصے کی تعداد ملنی چاہیے۔")
    ثبوت_چاہیے(سب(محدود_عدد(قدر, 1) ہر قدر میں اعتماد), "پیشگوئی کا اعتماد محدود صفر تا ایک ہو۔")
    جدول = [[0 ہر _ میں جماعتیں] ہر _ میں جماعتیں]
    ہر حقیقت, اندازہ میں اکٹھا(اصل, متوقع):
        ثبوت_چاہیے(قسم(حقیقت) ہے صحیح_عدد اور قسم(اندازہ) ہے صحیح_عدد اور 0 <= حقیقت < لمبائی(جماعتیں) اور 0 <= اندازہ < لمبائی(جماعتیں), "جماعت کا اشاریہ صحیح عدد اور مقررہ حد میں ہو۔")
        جدول[حقیقت][اندازہ] += 1
    درست = جوڑ(جدول[مقام][مقام] ہر مقام میں حد(لمبائی(جماعتیں)))
    ثبوت_چاہیے(قسم(خلاصہ["آزمائشی_درست"]) ہے صحیح_عدد اور خلاصہ["آزمائشی_درست"] == درست, "درست پیشگوئیوں کی گنتی خلاصے سے مختلف ہے۔")
    ثبوت_چاہیے(محدود_عدد(خلاصہ["آزمائشی_درستگی"], 1) اور ریاضی.قریب_ہے(خلاصہ["آزمائشی_درستگی"], درست / کل, مطلق_رواداری=0.000000000001), "درستگی پیشگوئیوں کے آزاد حساب سے مختلف ہے۔")
    ثبوت_چاہیے(محدود_عدد(خلاصہ["آزمائشی_نقصان"]), "آزمائشی نقصان محدود اور غیر منفی ہو۔")
    واپس {"حالت": "کامیاب", "الجھاؤ": جدول, "آزمائشی_درست": درست, "آزمائشی_تعداد": کل, "آزمائشی_درستگی": درست / کل, "بہترین_دور": بہترین_دور, "بہترین_توثیقی_درستگی": بہترین_قدر}


فنکشن جدول_اور_رپورٹ(منزل, خلاصہ, ثبوت):
    جماعتیں = خلاصہ["جماعتیں"]
    جدول = ثبوت["الجھاؤ"]
    ساتھ (منزل / ("الجھاؤ_جدول" + کوما_توسیع)).کھولو(لکھنے_حالت, نئی_سطر="", رمزبندی=متن_رمزبندی) بطور فائل:
        مصنف = جدولی_متن.جدول_مصنف(فائل)
        مصنف.قطار_لکھو(["حقیقی جماعت بمقابلہ پیشگوئی"] + جماعتیں)
        ہر نام, صف میں اکٹھا(جماعتیں, جدول):
            مصنف.قطار_لکھو([نام] + [اردو_عدد(قدر) ہر قدر میں صف])
    ساتھ (منزل / ("جماعتی_نتائج" + کوما_توسیع)).کھولو(لکھنے_حالت, نئی_سطر="", رمزبندی=متن_رمزبندی) بطور فائل:
        مصنف = جدولی_متن.جدول_مصنف(فائل)
        مصنف.قطار_لکھو(["حقیقی جماعت", "کل تصاویر", "درست پیشگوئیاں", "غلط پیشگوئیاں", "بازیافت فیصد"])
        ہر مقام, نام میں گنو(جماعتیں):
            کل = جوڑ(جدول[مقام])
            درست = جدول[مقام][مقام]
            شرح = گول(100 * درست / کل, 2) اگر کل ورنہ کچھ_نہیں
            مصنف.قطار_لکھو([نام, اردو_عدد(کل), اردو_عدد(درست), اردو_عدد(کل - درست), اردو_عدد(شرح) اگر کل ورنہ "کوئی تصویر نہیں"])
    سطور = ["# اردو ریسنیٹ کے اصل نتائج", "", "آزمائشی درستگی: **" + اردو_عدد(گول(100 * ثبوت["آزمائشی_درستگی"], 2)) + "٪**؛ درست تصاویر **" + اردو_عدد(ثبوت["آزمائشی_درست"]) + " / " + اردو_عدد(ثبوت["آزمائشی_تعداد"]) + "**۔", "", "تربیتی تصاویر: " + اردو_عدد(خلاصہ["تربیتی_تعداد"]) + "؛ توثیقی تصاویر: " + اردو_عدد(خلاصہ["توثیقی_تعداد"]) + "۔", "", "منتخب دور: " + اردو_عدد(ثبوت["بہترین_دور"]) + "؛ توثیقی درستگی: " + اردو_عدد(گول(100 * ثبوت["بہترین_توثیقی_درستگی"], 2)) + "٪۔", "", "یہ رپورٹ محفوظ تاریخ اور پیشگوئیوں سے دوبارہ حساب کرتی ہے۔ نئی تربیت، خام آزمائشی نشان کی آزاد تصدیق، یا دس فولڈ معیار کا دعویٰ نہیں کرتی۔", "", "| جماعت | کل تصاویر | درست | بازیافت |", "|---|---:|---:|---:|"]
    ہر مقام, نام میں گنو(جماعتیں):
        کل = جوڑ(جدول[مقام])
        درست = جدول[مقام][مقام]
        شرح = اردو_عدد(گول(100 * درست / کل, 2)) + "٪" اگر کل ورنہ "کوئی تصویر نہیں"
        سطور.آخر_لگاؤ("| " + نام + " | " + اردو_عدد(کل) + " | " + اردو_عدد(درست) + " | " + شرح + " |")
    ہر نام, عنوان میں (("تربیتی_خاکے", "تربیت اور توثیق"), ("الجھاؤ_جدول", "آزمائشی الجھاؤ جدول"), ("جماعتی_درستگی", "ہر جماعت کی درستگی"), ("پیشگوئیاں", "تصویری پیشگوئیاں")):
        سطور.بڑھاؤ(["", "## " + عنوان, "", "![" + عنوان + "](خاکے/" + نام + تصویر_توسیع + ")"])
    (منزل / ("نتائج" + اصل_متن("متن_۴۶_۱۰۹_۱۰۰"))).متن_لکھو(حرف(10).جوڑو(سطور), رمزبندی=متن_رمزبندی)


فنکشن نتیجہ_جانچو(نتائج, مکمل_فائلیں=سچ, وزن_جانچ=سچ):
    منزل = فائل_راستہ(نتائج).مکمل_راستہ()
    کوشش:
        تاریخ = پڑھو(منزل / ("تاریخ" + جیسن_توسیع))
        خلاصہ = پڑھو(منزل / ("خلاصہ" + جیسن_توسیع))
        پیشگوئیاں = پڑھو(منزل / ("پیشگوئیاں" + جیسن_توسیع))
        ثبوت = حساب_جانچو(تاریخ, خلاصہ, پیشگوئیاں)
        اگر "بحالی_فرق" میں خلاصہ:
            ثبوت_چاہیے(محدود_عدد(خلاصہ["بحالی_فرق"]) اور خلاصہ["بحالی_فرق"] == 0, "تربیت میں درج وزن کی بحالی کا فرق صفر ہونا چاہیے۔")
            ثبوت["درج_بحالی_فرق"] = خلاصہ["بحالی_فرق"]
        اگر "وزن_خلاصہ" میں خلاصہ:
            وزن_فائل = منزل / ("بہترین_وزن" + وزن_توسیع)
            ثبوت_چاہیے(فائل_ہیش(وزن_فائل) == خلاصہ["وزن_خلاصہ"], "محفوظ وزن کا ہیش رپورٹ سے مختلف ہے۔")
            ثبوت["وزن_خلاصہ"] = خلاصہ["وزن_خلاصہ"]
        اگر "ماخذ_خلاصے" میں خلاصہ:
            ہر نام, متوقع میں خلاصہ["ماخذ_خلاصے"].جوڑے():
                ثبوت_چاہیے(فائل_راستہ(نام).بنیادی_نام + فائل_راستہ(نام).لاحقہ == نام اور فائل_راستہ(نام).لاحقہ == اردو_توسیع, "ماخذ کا نام اسی فولڈر کی اردو فائل ہونا چاہیے۔")
                ثبوت_چاہیے(فائل_ہیش(فائل_راستہ(موجودہ_فائل).والد / نام) == متوقع, "تربیت کے بعد ماخذ کی فائل بدل گئی ہے۔")
            ثبوت["ماخذ_خلاصے_درست"] = سچ
        اگر مکمل_فائلیں:
            ثبوت["فائلیں"] = {}
            ہر نام میں ("تربیتی_خاکے", "الجھاؤ_جدول", "جماعتی_درستگی", "پیشگوئیاں"):
                ہر توسیع میں (تصویر_توسیع, ویکٹر_توسیع):
                    فائل = منزل / "خاکے" / (نام + توسیع)
                    ثبوت_چاہیے(فائل.فائل_ہے() اور لمبائی(فائل.بائٹ_پڑھو()) > 100, "خاکے کی فائل موجود اور غیر خالی ہونی چاہیے۔")
                    ثبوت["فائلیں"][نام + توسیع] = فائل_ہیش(فائل)
        اگر وزن_جانچ:
            درآمد ٹارچ
            سے ماڈل درآمد ریسنیٹ۱۸
            ماڈل = ریسنیٹ۱۸(لمبائی(خلاصہ["جماعتیں"]), خلاصہ["چوڑائی"])
            وزن = ٹارچ.لوڈ(منزل / ("بہترین_وزن" + وزن_توسیع), مقام_نقشہ=مرکزی_آلہ, صرف_وزن=سچ)
            ماڈل.حالت_لوڈ(وزن)
            ماڈل.جانچ()
            ثبوت_چاہیے(جوڑ(پیرامیٹر.عناصر_گنتی() ہر پیرامیٹر میں ماڈل.پیرامیٹر()) == خلاصہ["پیرامیٹر"], "محفوظ ماڈل کے پیرامیٹر کی تعداد خلاصے سے مختلف ہے۔")
            ثبوت_چاہیے(سب(بولی(ٹارچ.محدود_ہے(قدر).سب()) ہر قدر میں وزن.قدریں()), "محفوظ وزن میں غیر محدود عدد نہیں ہو سکتا۔")
            ثبوت["وزن_ساخت_لوڈ_درست"] = سچ
        جدول_اور_رپورٹ(منزل, خلاصہ, ثبوت)
        لکھو(منزل / ("تصدیق" + جیسن_توسیع), ثبوت)
        واپس ثبوت
    سوائے استثنا بطور خطا:
        لکھو(منزل / ("تصدیق" + جیسن_توسیع), {"حالت": "ناکام", "وجہ": متن(خطا)})
        اٹھاؤ


فنکشن چلائیں():
    تجزیہ = اردو_دلائل_تجزیہ_کار(پروگرام="اردو نتائج کی جانچ", وضاحت_متن=دستاویز_متن)
    تجزیہ.دلیل_شامل("--نتائج", دلیل_قسم=فائل_راستہ, لازم=سچ)
    اختیار = تجزیہ.دلائل_پڑھو()
    ثبوت = نتیجہ_جانچو(اختیار.نتائج)
    دکھاؤ("جانچ کامیاب؛ درست تصاویر:", اردو_عدد(ثبوت["آزمائشی_درست"]), "/", اردو_عدد(ثبوت["آزمائشی_تعداد"]))


اگر نام_ماڈیول == مرکزی_نام:
    چلائیں()
