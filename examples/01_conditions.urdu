# شرط، برابر قدریں، ایک ہی شے، اور غیر موجود قدر
عمر = 20
اگر عمر >= 18:
    درجہ = "بالغ"
ورنہ_اگر عمر >= 13:
    درجہ = "نوجوان"
ورنہ:
    درجہ = "بچہ"

الف = []
ب = []
ج = الف
جواب = کچھ_نہیں
RESULT = {
    "category": درجہ,
    "equal_values": الف == ب,
    "same_distinct": الف ہے ب,
    "same_alias": الف ہے ج,
    "missing": جواب ہے کچھ_نہیں,
    "empty_is_missing": الف ہے کچھ_نہیں,
    "booleans": [سچ, جھوٹ],
    "logic": سچ اور نہیں جھوٹ,
}
دکھاؤ(درجہ)
دکھاؤ(RESULT["equal_values"], RESULT["same_distinct"], RESULT["same_alias"])
