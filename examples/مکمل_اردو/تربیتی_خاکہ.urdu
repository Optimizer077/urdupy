# اردوپائی: مکمل
درآمد خاکہ
درآمد خط_حروف
درآمد اردو_تشکیل
درآمد دو_سمتی_متن
سے عصبی_تربیت درآمد سکھاؤ


فنکشن متصل_اردو(عبارت):
    اگر خط_حروف.مقامی_حروف_نسخہ:
        واپس عبارت
    واپس دو_سمتی_متن.حاصل_نمائش(اردو_تشکیل.نئی_شکل(عبارت))


فنکشن اردو_عدد(مقدار):
    ہندسے = "۰۱۲۳۴۵۶۷۸۹"
    واپس "".جوڑو(
        ہندسے[صحیح_عدد(حرف)] اگر حرف میں "0123456789" ورنہ حرف
        ہر حرف میں متن(گول(مقدار, 3)))


فنکشن خاکہ_بناؤ(منزل):
    خاکہ.پس_منظر_بدلو(بلا_پردہ_خاکہ)
    ماڈل, تاریخ, آمد, ہدف, پہلا_تدریج = سکھاؤ()
    پیکر, محور = خاکہ.ذیلی_خاکے(خاکہ_حجم=(8, 5))
    محور.خط_کھینچو(فہرست(حد(لمبائی(تاریخ))), تاریخ, خط_موٹائی=2)
    محور.عنوان_مقرر(متصل_اردو("حقیقی عصبی تربیت کا نقصان"), خط_خاندان=اردو_خط, خط_حجم=16)
    محور.افقی_نام_مقرر(متصل_اردو("تربیت کا دور"), خط_خاندان=اردو_خط, خط_حجم=13)
    محور.عمودی_نام_مقرر(متصل_اردو("اوسط مربع نقصان"), خط_خاندان=اردو_خط, خط_حجم=13)
    افقی_قدریں = [0, 30, 60, 90, 120]
    عمودی_قدریں = [0, زیادہترین(تاریخ) / 2, زیادہترین(تاریخ)]
    محور.افقی_نشان_مقرر(افقی_قدریں, نام_پٹیاں=[اردو_عدد(قدر) ہر قدر میں افقی_قدریں])
    محور.عمودی_نشان_مقرر(عمودی_قدریں, نام_پٹیاں=[اردو_عدد(قدر) ہر قدر میں عمودی_قدریں])
    محور.جالی(سچ, شفافیت=0.25)
    پیکر.قریب_ترتیب()
    پیکر.خاکہ_محفوظ(منزل, نقطے_فی_انچ=150)
    واپس پیکر, محور


اگر نام_ماڈیول == مرکزی_نام:
    پیکر, محور = خاکہ_بناؤ("تربیتی_نقصان")
    خاکہ.بند(پیکر)
    دکھاؤ("تربیتی نقصان کا اردو خاکہ محفوظ ہو گیا")
