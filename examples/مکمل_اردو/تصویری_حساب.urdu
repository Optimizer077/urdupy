# اردوپائی: مکمل
درآمد نمپی
درآمد تصویری_عمل
سے تصاویر درآمد تصویر


فنکشن تصویری_راستہ():
    """بیرونی تصویر کے بغیر تین اصل کتب خانوں کا مشترک حساب۔"""
    رنگ = نمپی.سرنی([
        [[255, 0, 0], [0, 255, 0]],
        [[0, 0, 255], [255, 255, 255]],
    ], قسم_اعداد=نمپی.غیر_منفی۸)
    سرمئی = تصویری_عمل.رنگ_بدلو(
        رنگ, تصویری_عمل.سرخ_سبز_نیلا_سے_سرمئی)
    بڑی = تصویری_عمل.حجم_بدلو(سرمئی, (4, 4))
    عکس = تصویر.سرنی_سے(رنگ)
    واپس رنگ, سرمئی, بڑی, عکس.حجم_بدلو((4, 4))


اگر نام_ماڈیول == مرکزی_نام:
    رنگ, سرمئی, بڑی, عکس = تصویری_راستہ()
    دکھاؤ("سرمئی تصویر:", سرمئی, "نیا حجم:", بڑی.شکل)
