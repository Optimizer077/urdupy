# اردوپائی: مکمل
درآمد ٹارچ
درآمد بصارت
درآمد مبدل


فنکشن تصویر_بدلو(عکس):
    تبدیلی = بصارت.تبدیلیاں.مرکب([
        بصارت.تبدیلیاں.حجم_تبدیلی((4, 4)),
        بصارت.تبدیلیاں.تصویر_سے_ٹینسر(),
        بصارت.تبدیلیاں.اعداد_قسم_بدلو(ٹارچ.اعشاری۳۲),
    ])
    واپس تبدیلی(عکس)


فنکشن زبان_بناؤ():
    """چھوٹا مقامی ماڈل؛ نہ تیار وزن، نہ رابطہ، نہ ڈاؤن لوڈ۔"""
    ٹارچ.بیج_مقرر(7)
    ترتیب = مبدل.برٹ_ترتیب(
        لغت_حجم=16, پوشیدہ_حجم=8, پوشیدہ_تہیں=1,
        توجہی_سر=2, درمیانی_حجم=16, زیادہ_مقامات=16,
        پوشیدہ_چھوڑ=0.0, توجہ_چھوڑ=0.0)
    ماڈل = مبدل.برٹ_ماڈل(ترتیب).منتقل(مرکزی_آلہ).جانچ()
    شناختیں = ٹارچ.ٹینسر([[1, 2, 3]], قسم_اعداد=ٹارچ.صحیح۶۴, آلہ=مرکزی_آلہ)
    ساتھ ٹارچ.بلا_تدریج():
        نتیجہ = ماڈل(دخل_شناختیں=شناختیں).آخری_پوشیدہ_حالت
    واپس ماڈل, نتیجہ


اگر نام_ماڈیول == مرکزی_نام:
    ماڈل, نتیجہ = زبان_بناؤ()
    دکھاؤ("زبان کے ٹینسر کی شکل:", فہرست(نتیجہ.شکل))
