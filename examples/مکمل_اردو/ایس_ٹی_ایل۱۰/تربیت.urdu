# اردوپائی: مکمل
"""اصل تصویری مجموعے پر مکمل اردو ریسنیٹ کی تربیت اور جانچ۔"""
سے اردوپائی.احکام درآمد اردو_دلائل_تجزیہ_کار
درآمد جیسن
درآمد جدولی_متن
درآمد خلاصہ_حساب
درآمد اتفاق
درآمد وقت
درآمد پلیٹ_فارم
درآمد راستے
درآمد نمپی
درآمد ٹارچ
سے ماڈل درآمد ریسنیٹ۱۸
سے اعداد درآمد اعداد_تیار_کرو


_جیسن_لاحقہ = جیسن_توسیع
_جدول_لاحقہ = کوما_توسیع
_وزن_لاحقہ = وزن_توسیع


فنکشن دستاویز_لکھو(مقام, معلومات):
    عبارت = جیسن.جیسن_متن(
        معلومات, انگریزی_رمز_لازم=جھوٹ, آگے_فاصلہ=2, عدد_نامعلوم_اجازت=جھوٹ)
    راستے.راستہ(مقام).متن_لکھو(عبارت + حرف(10), رمزبندی=متن_رمزبندی)


فنکشن جدول_لکھو(مقام, سطریں):
    ساتھ راستے.راستہ(مقام).کھولو(لکھنے_حالت, نئی_سطر="", رمزبندی=متن_رمزبندی) بطور بہاؤ:
        مصنف = جدولی_متن.لغتی_جدول_مصنف(بہاؤ, خانوں_نام=فہرست(سطریں[0]))
        مصنف.جدول_سر_لکھو()
        مصنف.جدول_سطریں_لکھو(سطریں)


فنکشن بیج_لگاؤ(تخم):
    اتفاق.بیج(تخم)
    نمپی.اتفاقی.بیج(تخم)
    ٹارچ.بیج_مقرر(تخم)


فنکشن آلہ_چنو(انتخاب):
    اگر انتخاب == "گرافیکی":
        اگر نہیں ٹارچ.گرافیکی.دستیاب():
            اٹھاؤ قدر_خطا("اس ماحول میں گرافیکی آلہ دستیاب نہیں")
        واپس ٹارچ.آلہ(گرافیکی_آلہ)
    اگر انتخاب != "مرکزی":
        اٹھاؤ قدر_خطا("آلہ مرکزی یا گرافیکی ہونا چاہیے")
    واپس ٹارچ.آلہ(مرکزی_آلہ)


فنکشن بیچ_منتقل(تصویریں, اہداف, منتخب_آلہ):
    اگر منتخب_آلہ.قسم == گرافیکی_آلہ:
        تصویریں = تصویریں.منتقل(
            آلہ=منتخب_آلہ, یادداشت_وضع=ٹارچ.چینل_آخر, غیر_مسدود=سچ)
    ورنہ:
        تصویریں = تصویریں.منتقل(آلہ=منتخب_آلہ)
    واپس تصویریں, اہداف.منتقل(منتخب_آلہ, غیر_مسدود=سچ)


فنکشن دور_سکھاؤ(نیٹ, بہاؤ, کسوٹی, بہترکار, منتخب_آلہ, پیمانہ_کار):
    نیٹ.تربیت()
    مجموعی_نقصان, درست, گنتی = 0.0, 0, 0
    ہر تصویریں, اہداف میں بہاؤ:
        تصویریں, اہداف = بیچ_منتقل(تصویریں, اہداف, منتخب_آلہ)
        بہترکار.صفر_تدریج(صفر_کے_بجائے_عدم=سچ)
        ساتھ ٹارچ.خودکار_دقت(
            آلہ_قسم=منتخب_آلہ.قسم, قسم_اعداد=ٹارچ.اعشاری۱۶,
            فعال=منتخب_آلہ.قسم == گرافیکی_آلہ):
            لاگٹس = نیٹ(تصویریں)
            نقصان_قدر = کسوٹی(لاگٹس, اہداف)
        اگر نہیں ٹارچ.محدود_ہے(نقصان_قدر):
            اٹھاؤ عملی_خطا("تربیتی نقصان محدود عدد نہیں ہے")
        پیمانہ_کار.پیمانہ(نقصان_قدر).پیچھے()
        پیمانہ_کار.قدم(بہترکار)
        پیمانہ_کار.تازہ()
        بیچ_گنتی = اہداف.حجم(0)
        مجموعی_نقصان += نقصان_قدر.عدد_لو() * بیچ_گنتی
        درست += (لاگٹس.زیادہترین_اشاریہ(بعد=1) == اہداف).جمع_کل().عدد_لو()
        گنتی += بیچ_گنتی
    اگر گنتی == 0:
        اٹھاؤ قدر_خطا("تربیتی مجموعہ خالی ہے")
    واپس {"نقصان": مجموعی_نقصان / گنتی, "درستگی": درست / گنتی, "تعداد": گنتی}


@ٹارچ.استدلال_حالت()
فنکشن دور_جانچو(نیٹ, بہاؤ, کسوٹی, منتخب_آلہ, پیشگوئی=جھوٹ):
    نیٹ.جانچ()
    مجموعی_نقصان, درست, گنتی = 0.0, 0, 0
    اصل, متوقع, اعتماد = [], [], []
    نمونہ_آمد, نمونہ_جواب = کچھ_نہیں, کچھ_نہیں
    ہر تصویریں, اہداف میں بہاؤ:
        تصویریں, اہداف = بیچ_منتقل(تصویریں, اہداف, منتخب_آلہ)
        ساتھ ٹارچ.خودکار_دقت(
            آلہ_قسم=منتخب_آلہ.قسم, قسم_اعداد=ٹارچ.اعشاری۱۶,
            فعال=منتخب_آلہ.قسم == گرافیکی_آلہ):
            لاگٹس = نیٹ(تصویریں)
            نقصان_قدر = کسوٹی(لاگٹس, اہداف)
        اگر نہیں ٹارچ.محدود_ہے(نقصان_قدر):
            اٹھاؤ عملی_خطا("جانچ کا نقصان محدود عدد نہیں ہے")
        بیچ_گنتی = اہداف.حجم(0)
        مجموعی_نقصان += نقصان_قدر.عدد_لو() * بیچ_گنتی
        اندازہ = لاگٹس.زیادہترین_اشاریہ(بعد=1)
        درست += (اندازہ == اہداف).جمع_کل().عدد_لو()
        گنتی += بیچ_گنتی
        اگر پیشگوئی:
            اصل.بڑھاؤ(اہداف.مرکزی().فہرست_میں())
            متوقع.بڑھاؤ(اندازہ.مرکزی().فہرست_میں())
            اعتماد.بڑھاؤ(لاگٹس.اعشاری_ٹینسر().نرم_زیادہ_عمل(بعد=1).زیادہترین(بعد=1).قدریں.مرکزی().فہرست_میں())
            اگر نمونہ_آمد ہے کچھ_نہیں:
                نمونہ_آمد = تصویریں.مرکزی().نقل_ٹینسر()
                نمونہ_جواب = لاگٹس.مرکزی().نقل_ٹینسر()
    اگر گنتی == 0:
        اٹھاؤ قدر_خطا("جانچ کا مجموعہ خالی ہے")
    واپس {"نقصان": مجموعی_نقصان / گنتی, "درستگی": درست / گنتی,
        "درست": درست, "تعداد": گنتی, "اصل": اصل, "متوقع": متوقع,
        "اعتماد": اعتماد, "نمونہ_آمد": نمونہ_آمد, "نمونہ_جواب": نمونہ_جواب}


فنکشن تربیت_چلاؤ(مجموعے, منزل, ادوار=50, بیچ=64, چوڑائی=64,
                 تھریڈ=6, تخم=42, شرح=0.05, آلہ_انتخاب="مرکزی", خاکے=سچ):
    """توثیق سے انتخاب؛ پورا آزمائشی مجموعہ صرف آخر میں ایک بار۔"""
    اگر کمترین(ادوار, بیچ, چوڑائی, تھریڈ) < 1 یا نہیں شرح > 0 یا نہیں ریاضی_محدود(شرح) یا نہیں 0 <= تخم < 4294967296:
        اٹھاؤ قدر_خطا("ادوار، بیچ، چوڑائی، تھریڈ اور شرح مثبت محدود عدد ہوں")
    منتخب_آلہ = آلہ_چنو(آلہ_انتخاب)
    منزل = راستے.راستہ(منزل).مکمل_راستہ()
    اگر منزل.موجود() اور (نہیں منزل.فولڈر_ہے() یا کوئی(منزل.فولڈر_ارکان())):
        اٹھاؤ قدر_خطا("نتائج کا فولڈر خالی ہونا چاہیے؛ نیا فولڈر منتخب کریں")
    اگر لمبائی(مجموعے["جماعتیں"]) < 2:
        اٹھاؤ قدر_خطا("کم از کم دو جماعتیں درکار ہیں")
    ہر حصہ_نام میں ("تربیتی", "توثیقی", "آزمائشی"):
        اگر لمبائی(مجموعے[حصہ_نام]) == 0:
            اٹھاؤ قدر_خطا("مجموعے خالی نہیں ہو سکتے")
    منزل.فولڈر_بناؤ(والدین=سچ, موجود_اجازت=سچ)
    ٹارچ.دھاگے_مقرر(تھریڈ)
    بیج_لگاؤ(تخم)
    ترتیب_حساب = {"ادوار": ادوار, "بیچ": بیچ, "چوڑائی": چوڑائی,
        "تھریڈ": تھریڈ, "تخم": تخم, "شرح": شرح, "آلہ": آلہ_انتخاب,
        "جسامت": مجموعے["جسامت"], "حالت": "تربیت جاری"}
    ماحول = {"ترتیب": ترتیب_حساب, "پائتھن": پلیٹ_فارم.پائتھن_نسخہ(),
        "نظام": پلیٹ_فارم.پلیٹ_تفصیل(), "ٹارچ": متن(ٹارچ.نسخہ),
        "نمپی": متن(نمپی.نسخہ), "گرافیکی_نسخہ": ٹارچ.نسخہ_ماڈیول.گرافیکی,
        "آلہ": ٹارچ.گرافیکی.آلہ_نام(0) اگر آلہ_انتخاب == "گرافیکی" ورنہ "مرکزی",
        "دقت": "خودکار نصف اور مکمل اعشاری" اگر آلہ_انتخاب == "گرافیکی" ورنہ "مکمل اعشاری"}
    دستاویز_لکھو(منزل / ("ماحول" + _جیسن_لاحقہ), ماحول)
    دستاویز_لکھو(منزل / ("تقسیم" + _جیسن_لاحقہ), {
        "تربیتی_اشاریے": مجموعے["تربیتی_اشاریے"],
        "توثیقی_اشاریے": مجموعے["توثیقی_اشاریے"],
        "اوسط": مجموعے["اوسط"], "انحراف": مجموعے["انحراف"],
        "جماعتیں": مجموعے["جماعتیں"], "ماخذ": مجموعے["ماخذ"]})
    بہاؤ_تخم = ٹارچ.جنریٹر().بیج_مقرر(تخم)
    تربیتی_بہاؤ = ٹارچ.سہولتیں.مواد.مواد_بہاؤ(
        مجموعے["تربیتی"], بیچ_حجم=بیچ, پھینٹنا=سچ, کارکن=0,
        یادداشت_باندھو=آلہ_انتخاب == "گرافیکی", بیج_جنریٹر=بہاؤ_تخم)
    توثیقی_بہاؤ = ٹارچ.سہولتیں.مواد.مواد_بہاؤ(
        مجموعے["توثیقی"], بیچ_حجم=بیچ, پھینٹنا=جھوٹ, کارکن=0,
        یادداشت_باندھو=آلہ_انتخاب == "گرافیکی")
    نیٹ = ریسنیٹ۱۸(جماعتیں=لمبائی(مجموعے["جماعتیں"]), چوڑائی=چوڑائی).منتقل(منتخب_آلہ)
    اگر آلہ_انتخاب == "گرافیکی":
        نیٹ = نیٹ.منتقل(یادداشت_وضع=ٹارچ.چینل_آخر)
    کسوٹی = ٹارچ.عصبی.درجہ_نقصان()
    بہترکار = ٹارچ.اصلاح.اتفاقی_تدریجی_نزول(
        نیٹ.پیرامیٹر(), شرح_تعلم=شرح, رفتار_یادداشت=0.9, وزن_زوال=0.0005)
    پیمانہ_کار = ٹارچ.مخلوط_دقت.تدریج_پیمانہ(گرافیکی_آلہ, فعال=آلہ_انتخاب == "گرافیکی")
    شرح_کار = ٹارچ.اصلاح.شیڈول.رفتار_کوسائن(بہترکار, کل_ادوار=ادوار)
    تاریخ_ادوار, بہترین_درستگی, بہترین_دور = [], -1.0, 0
    شروع_وقت = وقت.کارکردگی_وقت()
    ہر دور_عدد میں حد(1, ادوار + 1):
        دور_شروع = وقت.کارکردگی_وقت()
        موجودہ_شرح = بہترکار.پیرامیٹر_گروہ[0][اصل_متن("متن_۱۰۸_۱۱۴")]
        سیکھا = دور_سکھاؤ(نیٹ, تربیتی_بہاؤ, کسوٹی, بہترکار, منتخب_آلہ, پیمانہ_کار)
        جانچا = دور_جانچو(نیٹ, توثیقی_بہاؤ, کسوٹی, منتخب_آلہ)
        سطر = {"دور": دور_عدد, "تربیتی_نقصان": سیکھا["نقصان"],
            "تربیتی_درستگی": سیکھا["درستگی"], "توثیقی_نقصان": جانچا["نقصان"],
            "توثیقی_درستگی": جانچا["درستگی"], "شرح": موجودہ_شرح,
            "ثانیے": وقت.کارکردگی_وقت() - دور_شروع}
        تاریخ_ادوار.آخر_لگاؤ(سطر)
        شرح_کار.قدم()
        اگر جانچا["درستگی"] > بہترین_درستگی:
            بہترین_درستگی, بہترین_دور = جانچا["درستگی"], دور_عدد
            ٹارچ.محفوظ(نیٹ.حالت_لغت(), منزل / ("بہترین_وزن" + _وزن_لاحقہ))
        ٹارچ.محفوظ({"دور": دور_عدد, "بہترین_دور": بہترین_دور,
            "بہترین_توثیقی_درستگی": بہترین_درستگی, "تاریخ": تاریخ_ادوار,
            "ماڈل": نیٹ.حالت_لغت(),
            "اصلاح_کار": بہترکار.حالت_لغت(), "شرح_کار": شرح_کار.حالت_لغت(),
            "دقت_کار": پیمانہ_کار.حالت_لغت(), "ترتیب": ترتیب_حساب,
            "ٹارچ_اتفاقی_حالت": ٹارچ.اتفاقی_حالت_لو(),
            "بہاؤ_اتفاقی_حالت": بہاؤ_تخم.حالت_لو(),
            "افزائش_حالت": مجموعے["تربیتی"].تخمی_اوزار.حالت_لو() اگر خاصیت_ہے(مجموعے["تربیتی"], "تخمی_اوزار") ورنہ کچھ_نہیں},
            منزل / ("آخری_حالت" + _وزن_لاحقہ))
        دستاویز_لکھو(منزل / ("تاریخ" + _جیسن_لاحقہ), تاریخ_ادوار)
        جدول_لکھو(منزل / ("تاریخ" + _جدول_لاحقہ), تاریخ_ادوار)
        دکھاؤ("دور", دور_عدد, "از", ادوار, "تربیتی نقصان", گول(سیکھا["نقصان"], 5),
            "توثیقی درستگی", گول(جانچا["درستگی"] * 100, 2), "فیصد", بہاؤ_خالی=سچ)
    نیٹ.حالت_لوڈ(ٹارچ.لوڈ(
        منزل / ("بہترین_وزن" + _وزن_لاحقہ), مقام_نقشہ=منتخب_آلہ, صرف_وزن=سچ))
    آزمائشی_بہاؤ = ٹارچ.سہولتیں.مواد.مواد_بہاؤ(
        مجموعے["آزمائشی"], بیچ_حجم=بیچ, پھینٹنا=جھوٹ, کارکن=0,
        یادداشت_باندھو=آلہ_انتخاب == "گرافیکی")
    آزمائش_نتیجہ = دور_جانچو(نیٹ, آزمائشی_بہاؤ, کسوٹی, منتخب_آلہ, پیشگوئی=سچ)
    پیشگوئیاں = {کلید: آزمائش_نتیجہ[کلید] ہر کلید میں ("اصل", "متوقع", "اعتماد")}
    بحال = ریسنیٹ۱۸(جماعتیں=لمبائی(مجموعے["جماعتیں"]), چوڑائی=چوڑائی).منتقل(منتخب_آلہ)
    اگر آلہ_انتخاب == "گرافیکی":
        بحال = بحال.منتقل(یادداشت_وضع=ٹارچ.چینل_آخر)
    بحال.حالت_لوڈ(ٹارچ.لوڈ(
        منزل / ("بہترین_وزن" + _وزن_لاحقہ), مقام_نقشہ=منتخب_آلہ, صرف_وزن=سچ))
    بحال.جانچ()
    نمونہ_آمد = آزمائش_نتیجہ["نمونہ_آمد"].منتقل(منتخب_آلہ)
    ساتھ ٹارچ.استدلال_حالت(), ٹارچ.خودکار_دقت(
        آلہ_قسم=منتخب_آلہ.قسم, قسم_اعداد=ٹارچ.اعشاری۱۶, فعال=آلہ_انتخاب == "گرافیکی"):
        بحالی_فرق = (بحال(نمونہ_آمد).مرکزی() - آزمائش_نتیجہ["نمونہ_جواب"]).مطلق().زیادہترین().عدد_لو()
    اگر بحالی_فرق != 0:
        اٹھاؤ عملی_خطا("محفوظ وزن بحال کرنے سے پیشگوئی بدل گئی")
    خلاصہ = {"مجموعہ": "ایس ٹی ایل دس", "بناوٹ": "ریسنیٹ اٹھارہ، چھوٹی تصویری ابتدائی تہہ",
        "بلاک": [2, 2, 2, 2], "دور": ادوار, "چوڑائی": چوڑائی, "جسامت": مجموعے["جسامت"],
        "تخم": تخم, "پیرامیٹر": جوڑ(جزو.عناصر_گنتی() ہر جزو میں نیٹ.پیرامیٹر()),
        "تربیتی_تعداد": لمبائی(مجموعے["تربیتی"]), "توثیقی_تعداد": لمبائی(مجموعے["توثیقی"]),
        "آزمائشی_تعداد": آزمائش_نتیجہ["تعداد"], "بہترین_دور": بہترین_دور,
        "بہترین_توثیقی_درستگی": بہترین_درستگی, "آزمائشی_درستگی": آزمائش_نتیجہ["درستگی"],
        "آزمائشی_درست": آزمائش_نتیجہ["درست"], "آزمائشی_نقصان": آزمائش_نتیجہ["نقصان"],
        "جماعتیں": مجموعے["جماعتیں"], "اوسط": مجموعے["اوسط"], "انحراف": مجموعے["انحراف"],
        "ثانیے": وقت.کارکردگی_وقت() - شروع_وقت, "آلہ": آلہ_انتخاب,
        "بحالی_فرق": بحالی_فرق,
        "وزن_خلاصہ": خلاصہ_حساب.شا۲۵۶((منزل / ("بہترین_وزن" + _وزن_لاحقہ)).بائٹ_پڑھو()).خلاصہ_متن(),
        "تربیت": "ابتدا سے؛ کوئی تیار وزن نہیں",
        "جانچ": "ایک مستقل تربیتی اور توثیقی تقسیم؛ توثیق سے انتخاب کے بعد اصل آزمائشی مجموعہ؛ دس تہہ جانچ نہیں"}
    دستاویز_لکھو(منزل / ("پیشگوئیاں" + _جیسن_لاحقہ), پیشگوئیاں)
    جدول_لکھو(منزل / ("پیشگوئیاں" + _جدول_لاحقہ), [
        {"ترتیب": ترتیب_عدد, "اصل_جماعت": مجموعے["جماعتیں"][اصل_قدر],
            "متوقع_جماعت": مجموعے["جماعتیں"][متوقع_قدر], "اعتماد": اعتماد_قدر}
        ہر ترتیب_عدد, (اصل_قدر, متوقع_قدر, اعتماد_قدر) میں گنو(اکٹھا(
            پیشگوئیاں["اصل"], پیشگوئیاں["متوقع"], پیشگوئیاں["اعتماد"]))])
    اوسط_ٹینسر = ٹارچ.ٹینسر(مجموعے["اوسط"]).نئی_شکل(3, 1, 1)
    انحراف_ٹینسر = ٹارچ.ٹینسر(مجموعے["انحراف"]).نئی_شکل(3, 1, 1)
    نمونہ_تصاویر = ((آزمائش_نتیجہ["نمونہ_آمد"][:16] * انحراف_ٹینسر + اوسط_ٹینسر).ٹینسر_محدود(0, 1) * 255).منتقل(قسم_اعداد=ٹارچ.غیر_منفی۸)
    نمونہ_اشاریے = فہرست(حد(لمبائی(نمونہ_تصاویر)))
    ٹارچ.محفوظ({"تصاویر": نمونہ_تصاویر, "نمونہ_اشاریے": نمونہ_اشاریے}, منزل / ("نمونہ_تصاویر" + _وزن_لاحقہ))
    دستاویز_لکھو(منزل / ("خلاصہ" + _جیسن_لاحقہ), خلاصہ)
    اگر خاکے:
        سے خاکے درآمد خاکے_بناؤ
        تصویری_پیشگوئیاں = پیشگوئیاں.نقل_سرنی()
        تصویری_پیشگوئیاں["تصاویر"] = نمونہ_تصاویر
        تصویری_پیشگوئیاں["نمونہ_اشاریے"] = نمونہ_اشاریے
        راستوں_فہرست = خاکے_بناؤ(تاریخ_ادوار, خلاصہ, تصویری_پیشگوئیاں, منزل)
        خلاصہ["خاکے"] = [متن(مقام.نسبت_راستہ(منزل)) ہر مقام میں راستوں_فہرست]
    ورنہ:
        خلاصہ["خاکے"] = []
    خلاصہ["ماخذ_خلاصے"] = {مقام.نام: خلاصہ_حساب.شا۲۵۶(مقام.بائٹ_پڑھو()).خلاصہ_متن()
        ہر مقام میں راستے.راستہ(موجودہ_فائل).والد.خاکے_تلاش("*" + اردو_توسیع)}
    دستاویز_لکھو(منزل / ("خلاصہ" + _جیسن_لاحقہ), خلاصہ)
    ترتیب_حساب["حالت"] = "مکمل"
    دستاویز_لکھو(منزل / ("ماحول" + _جیسن_لاحقہ), ماحول)
    دکھاؤ("تربیت مکمل؛ بہترین دور", بہترین_دور, "آزمائشی درستگی",
        گول(خلاصہ["آزمائشی_درستگی"] * 100, 2), "فیصد؛ نتائج", منزل, بہاؤ_خالی=سچ)
    واپس خلاصہ


فنکشن ریاضی_محدود(مقدار):
    واپس بولی(نمپی.محدود_ہے(مقدار))


فنکشن چلائیں(ذاتی_دلائل=کچھ_نہیں):
    تجزیہ = اردو_دلائل_تجزیہ_کار(پروگرام="اردو ریسنیٹ", وضاحت_متن="مکمل اردو ریسنیٹ کی اصل تصویری تربیت")
    تجزیہ.دلیل_شامل("--اعداد", منزل_دلیل="اعداد_جڑ", قسم=راستے.راستہ, لازم=سچ)
    تجزیہ.دلیل_شامل("--نتائج", منزل_دلیل="نتائج_جڑ", قسم=راستے.راستہ, لازم=سچ)
    تجزیہ.دلیل_شامل("--حاصل", عمل_دلیل=جھنڈا_سچ, مدد="صرف ضرورت پر اصل اعداد حاصل کریں")
    تجزیہ.دلیل_شامل("--ادوار", قسم=صحیح_عدد, طے_شدہ=50)
    تجزیہ.دلیل_شامل("--بیچ", قسم=صحیح_عدد, طے_شدہ=64)
    تجزیہ.دلیل_شامل("--جسامت", قسم=صحیح_عدد, طے_شدہ=96)
    تجزیہ.دلیل_شامل("--چوڑائی", قسم=صحیح_عدد, طے_شدہ=64)
    تجزیہ.دلیل_شامل("--تھریڈ", قسم=صحیح_عدد, طے_شدہ=6)
    تجزیہ.دلیل_شامل("--تخم", قسم=صحیح_عدد, طے_شدہ=42)
    تجزیہ.دلیل_شامل("--شرح", قسم=اعشاری, طے_شدہ=0.05)
    تجزیہ.دلیل_شامل("--آلہ", منزل_دلیل="منتخب_آلہ", انتخابات=["مرکزی", "گرافیکی"], طے_شدہ="مرکزی")
    اختیارات = تجزیہ.دلائل_پڑھو(ذاتی_دلائل)
    اگر کمترین(اختیارات.ادوار, اختیارات.بیچ, اختیارات.چوڑائی, اختیارات.تھریڈ) < 1 یا اختیارات.جسامت < 16 یا نہیں ریاضی_محدود(اختیارات.شرح) یا اختیارات.شرح <= 0 یا نہیں 0 <= اختیارات.تخم < 4294967296:
        تجزیہ.خطا_دو("ادوار، بیچ، چوڑائی، تھریڈ اور شرح مثبت ہوں؛ جسامت کم از کم سولہ ہو")
    آلہ_چنو(اختیارات.منتخب_آلہ)
    اگر اختیارات.نتائج_جڑ.موجود() اور (نہیں اختیارات.نتائج_جڑ.فولڈر_ہے() یا کوئی(اختیارات.نتائج_جڑ.فولڈر_ارکان())):
        تجزیہ.خطا_دو("نتائج کا فولڈر خالی ہونا چاہیے")
    دکھاؤ("اصل اعداد کی تیاری؛ تقسیم اور معمول صرف تربیتی حصے سے", بہاؤ_خالی=سچ)
    مجموعے = اعداد_تیار_کرو(اختیارات.اعداد_جڑ, جسامت=اختیارات.جسامت, تخم=اختیارات.تخم, حصول=اختیارات.حاصل)
    واپس تربیت_چلاؤ(مجموعے, اختیارات.نتائج_جڑ, ادوار=اختیارات.ادوار,
        بیچ=اختیارات.بیچ, چوڑائی=اختیارات.چوڑائی, تھریڈ=اختیارات.تھریڈ,
        تخم=اختیارات.تخم, شرح=اختیارات.شرح, آلہ_انتخاب=اختیارات.منتخب_آلہ)


اگر نام_ماڈیول == مرکزی_نام:
    چلائیں()
